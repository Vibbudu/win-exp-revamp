import { LineEdit, ScrollView } from "std-widgets.slint";

export global Theme {
    in-out property <bool> is_dark: true;

    out property <color> titlebar_bg: is_dark ? #141414 : #dfe3e8;
    out property <color> nav_bg: is_dark ? #282828 : #f3f3f3;
    out property <color> cmd_bg: is_dark ? #202020 : #f8f8f8;
    out property <color> sidebar_bg: is_dark ? #191919 : #f0f2f5;
    out property <color> content_bg: is_dark ? #191919 : #ffffff;
    out property <color> pane_bg: is_dark ? #1e1e1e : #f7f8fa;
    out property <color> input_bg: is_dark ? #1d1d1d : #ffffff;
    out property <color> flyout_bg: is_dark ? #2b2b2b : #fcfcfc;

    out property <color> border: is_dark ? #3a3a3a : #d0d5dd;
    out property <color> divider: is_dark ? #2e2e2e : #e2e5ea;

    out property <color> hover_bg: is_dark ? #343434 : #e4e7ec;
    out property <color> row_hover: is_dark ? #262626 : #f1f5f9;
    out property <color> row_selected: is_dark ? #2f3742 : #e0eefb;

    out property <color> text_primary: is_dark ? #ffffff : #141414;
    out property <color> text_secondary: is_dark ? #d4d4d4 : #424242;
    out property <color> text_muted: is_dark ? #a0a0a0 : #686868;
    out property <color> accent: is_dark ? #60cdff : #0067c0;
}

export struct EntryItem {
    id: string,
    name: string,
    path: string,
    is_dir: bool,
    size_str: string,
    mtime_str: string,
    type_str: string,
    icon_glyph: string,
    icon_color: color,
}

export struct DriveItem {
    letter: string,
    name: string,
    free_str: string,
    total_str: string,
    percent_used: float,
}

export struct CrumbItem {
    label: string,
    path: string,
}

export struct TabItem {
    id: int,
    title: string,
    path: string,
    is_active: bool,
}

export struct PreviewRow {
    cells: [string],
}

export struct PropertyItem {
    name: string,
    value: string,
}

// Authentic Windows 11 Fluent 2-Tone Gold Folder Vector Icon (or File Glyph)
component FluentEntryIcon inherits Rectangle {
    in property <bool> is_dir: true;
    in property <string> glyph: "\u{E8A5}";
    in property <color> glyph_color: #cccccc;
    in property <bool> large: false;

    width: large ? 54px : 22px;
    height: large ? 44px : 19px;
    background: transparent;

    // Back tab of Windows 11 folder
    if root.is_dir: Rectangle {
        x: large ? 2px : 1px;
        y: large ? 3px : 2px;
        width: large ? 22px : 9px;
        height: large ? 10px : 5px;
        border-radius: large ? 3px : 1.5px;
        background: #d9960a;
    }

    // Back plate of folder
    if root.is_dir: Rectangle {
        x: large ? 2px : 1px;
        y: large ? 7px : 4px;
        width: large ? 50px : 20px;
        height: large ? 32px : 13px;
        border-radius: large ? 4px : 2px;
        background: #e3a414;
    }

    // Front bright gold plate of Windows 11 folder
    if root.is_dir: Rectangle {
        x: large ? 2px : 1px;
        y: large ? 11px : 6px;
        width: large ? 50px : 20px;
        height: large ? 29px : 11px;
        border-radius: large ? 4px : 2px;
        background: @linear-gradient(180deg, #ffe074 0%, #f5ba18 100%);
    }

    // Non-directory file icon using Segoe Fluent Icons
    if !root.is_dir: Text {
        text: root.glyph;
        font-family: "Segoe Fluent Icons";
        font-size: large ? 36px : 16px;
        color: root.glyph_color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component FluentIconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> is_active: false;
    in property <bool> is_disabled: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 4px;
    background: is_disabled ? transparent : (touch.pressed ? Theme.divider : (touch.has-hover ? Theme.hover_bg : (is_active ? Theme.hover_bg : transparent)));

    Text {
        text: root.icon;
        font-family: "Segoe Fluent Icons";
        font-size: 14px;
        color: is_disabled ? Theme.text_muted : Theme.text_primary;
        opacity: is_disabled ? 0.45 : 1.0;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: !root.is_disabled;
        clicked => { root.clicked(); }
    }
}

component CaptionButton inherits Rectangle {
    in property <string> icon;
    in property <bool> is_close: false;
    callback clicked();

    width: 46px;
    height: 32px;
    background: touch.has-hover ? (root.is_close ? #c42b1c : Theme.hover_bg) : transparent;

    Text {
        text: root.icon;
        font-family: "Segoe Fluent Icons";
        font-size: 10px;
        color: touch.has-hover ? (root.is_close ? #ffffff : Theme.text_primary) : Theme.text_secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component CommandBarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label: "";
    in property <color> icon_tint: Theme.text_primary;
    in property <bool> is_active: false;
    in property <bool> has_dropdown: false;
    in property <bool> is_disabled: false;
    callback clicked();

    height: 36px;
    min-width: root.label == "" ? 38px : 74px;
    border-radius: 5px;
    background: is_disabled ? transparent : (touch.pressed ? Theme.divider : (touch.has-hover ? Theme.hover_bg : (is_active ? Theme.hover_bg : transparent)));
    border-width: is_active ? 1px : 0px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: root.label == "" ? 10px : 11px;
        padding-right: root.label == "" ? 10px : 11px;
        spacing: 8px;

        Text {
            text: root.icon;
            font-family: "Segoe Fluent Icons";
            font-size: 16px;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: is_disabled ? Theme.text_muted : root.icon_tint;
            opacity: is_disabled ? 0.4 : 1.0;
        }

        if root.label != "": Text {
            text: root.label;
            font-size: 13.5px;
            font-weight: 500;
            vertical-alignment: center;
            color: is_disabled ? Theme.text_muted : Theme.text_primary;
            opacity: is_disabled ? 0.4 : 1.0;
        }

        if root.has_dropdown: Text {
            text: "\u{E70D}";
            font-family: "Segoe Fluent Icons";
            font-size: 10px;
            vertical-alignment: center;
            color: Theme.text_secondary;
        }
    }

    touch := TouchArea {
        enabled: !root.is_disabled;
        clicked => { root.clicked(); }
    }
}

component FlyoutMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <color> icon_color: Theme.text_primary;
    in property <bool> is_checked: false;
    in property <bool> has_chevron: false;
    callback clicked();

    height: 34px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.hover_bg : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;

        // Bullet indicator column (matches Windows 11 Sort/View flyout screenshots)
        Rectangle {
            width: 12px;
            if root.is_checked: Rectangle {
                width: 5px;
                height: 5px;
                x: 3px;
                y: (parent.height - self.height) / 2;
                border-radius: 2.5px;
                background: Theme.text_primary;
            }
        }

        if root.icon != "": Text {
            width: 18px;
            text: root.icon;
            font-family: "Segoe Fluent Icons";
            font-size: 15px;
            color: root.icon_color;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 13.5px;
            color: Theme.text_primary;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        if root.has_chevron: Text {
            width: 12px;
            text: "\u{E76C}";
            font-family: "Segoe Fluent Icons";
            font-size: 10px;
            color: Theme.text_secondary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <color> icon_color: #60cdff;
    in property <string> label;
    in property <bool> is_selected: false;
    in property <bool> is_pinned: false;
    callback clicked();

    height: 36px;
    border-radius: 5px;
    background: is_selected ? Theme.row_selected : (touch.has-hover ? Theme.row_hover : transparent);

    // Windows 11 left accent selection indicator pill
    if root.is_selected: Rectangle {
        x: 2px;
        y: 9px;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;

        Text {
            width: 20px;
            text: root.icon;
            font-family: "Segoe Fluent Icons";
            font-size: 16px;
            color: root.icon_color;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 14px;
            font-weight: is_selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-alignment: left;
            color: Theme.text_primary;
            overflow: elide;
        }

        if root.is_pinned: Text {
            width: 14px;
            text: "\u{E718}";
            font-family: "Segoe Fluent Icons";
            font-size: 11px;
            color: Theme.text_muted;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "File Explorer";
    no-frame: true;
    min-width: 1080px;
    min-height: 680px;
    preferred-width: 1320px;
    preferred-height: 800px;
    background: Theme.content_bg;
    default-font-family: "Segoe UI Variable Text";
    forward-focus: key_scope;

    // Theme synchronization with Windows 11 OS settings
    in-out property <bool> is_dark_mode <=> Theme.is_dark;

    // State properties
    in-out property <[TabItem]> tabs: [];
    in-out property <int> active_tab_index: 0;
    in-out property <[CrumbItem]> crumbs: [];
    in-out property <string> current_path: "";
    in-out property <string> current_folder_name: "Home";
    in-out property <string> active_nav_key: "home";
    in-out property <string> raw_path_text: "";
    in-out property <bool> is_editing_path: false;
    in-out property <string> search_text: "";

    // Flyout menu state ("", "new", "sort", "view")
    in-out property <string> active_flyout: "";
    in-out property <bool> show_hidden: true;

    // Inline Rename state
    in-out property <bool> is_renaming: false;
    in-out property <string> rename_text: "";

    in-out property <bool> can_go_back: false;
    in-out property <bool> can_go_forward: false;

    in-out property <[DriveItem]> drives: [];
    in-out property <[EntryItem]> entries: [];
    in-out property <int> selected_index: -1;
    in-out property <string> selected_path: "";

    in-out property <string> view_mode: "details"; // "details", "icons", "xl_icons", "tiles", "list"
    in-out property <string> sort_column: "name";
    in-out property <bool> sort_asc: true;

    in-out property <bool> show_preview: false;
    in-out property <bool> show_details: false;

    // Preview & Thumbnail Image state
    in-out property <string> preview_type: "none";
    in-out property <string> preview_title: "";
    in-out property <string> preview_subtitle: "";
    in-out property <string> preview_text_content: "";
    in-out property <bool> has_preview_image: false;
    in-out property <image> preview_image;
    in-out property <[string]> preview_table_headers: [];
    in-out property <[PreviewRow]> preview_table_rows: [];

    // Details pane state
    in-out property <[PropertyItem]> item_properties: [];

    // Status bar state
    in-out property <string> status_item_count: "0 items";
    in-out property <string> status_selection_info: "";

    // Window management callbacks
    callback window_minimize();
    callback window_maximize();
    callback window_close();
    callback window_drag();

    // Tab callbacks
    callback tab_selected(int);
    callback tab_closed(int);
    callback tab_new();

    // Navigation callbacks
    callback nav_back();
    callback nav_forward();
    callback nav_up();
    callback nav_refresh();
    callback nav_to_path(string);
    callback search_changed(string);

    // Item interaction callbacks
    callback item_clicked(int);
    callback item_double_clicked(int);
    callback item_right_clicked(int);

    // Command bar callbacks
    callback command_new_folder();
    callback command_new_file(string);
    callback command_map_network_drive();
    callback command_cut();
    callback command_copy();
    callback command_paste();
    callback command_rename();
    callback command_commit_rename(string);
    callback command_delete();
    callback command_toggle_view();
    callback command_set_view(string);
    callback command_toggle_preview();
    callback command_toggle_details();
    callback command_toggle_hidden();
    callback sort_by(string);
    callback sort_direction(bool);

    // Keyboard shortcut callback
    callback key_shortcut(string);

    key_scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.modifiers.control {
                if event.text == "t" || event.text == "T" {
                    root.tab_new();
                    return accept;
                }
                if event.text == "w" || event.text == "W" {
                    root.tab_closed(root.active_tab_index);
                    return accept;
                }
                if event.text == "l" || event.text == "L" {
                    root.raw_path_text = root.current_path;
                    root.is_editing_path = true;
                    return accept;
                }
                if event.text == "f" || event.text == "F" {
                    search_input.focus();
                    return accept;
                }
                if event.text == "c" || event.text == "C" {
                    root.command_copy();
                    return accept;
                }
                if event.text == "x" || event.text == "X" {
                    root.command_cut();
                    return accept;
                }
                if event.text == "v" || event.text == "V" {
                    root.command_paste();
                    return accept;
                }
                if event.text == "r" || event.text == "R" {
                    root.nav_refresh();
                    return accept;
                }
                if event.text == "n" || event.text == "N" {
                    root.command_new_folder();
                    return accept;
                }
            }
            if event.modifiers.alt {
                if event.text == Key.LeftArrow {
                    root.nav_back();
                    return accept;
                }
                if event.text == Key.RightArrow {
                    root.nav_forward();
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.nav_up();
                    return accept;
                }
                if event.text == "p" || event.text == "P" {
                    root.command_toggle_preview();
                    return accept;
                }
                if event.text == "d" || event.text == "D" {
                    root.raw_path_text = root.current_path;
                    root.is_editing_path = true;
                    return accept;
                }
            }
            if event.text == Key.F5 {
                root.nav_refresh();
                return accept;
            }
            if event.text == Key.F2 {
                root.command_rename();
                return accept;
            }
            if event.text == Key.Delete {
                root.command_delete();
                return accept;
            }
            if event.text == Key.Backspace && !root.is_editing_path && !root.is_renaming {
                root.nav_up();
                return accept;
            }
            if event.text == Key.Return && !root.is_editing_path && !root.is_renaming {
                if root.selected_index >= 0 {
                    root.item_double_clicked(root.selected_index);
                }
                return accept;
            }
            if event.text == Key.UpArrow && !root.is_editing_path && !root.is_renaming {
                root.key_shortcut("up");
                return accept;
            }
            if event.text == Key.DownArrow && !root.is_editing_path && !root.is_renaming {
                root.key_shortcut("down");
                return accept;
            }
            if event.text == Key.Escape {
                if root.active_flyout != "" {
                    root.active_flyout = "";
                } else if root.is_editing_path {
                    root.is_editing_path = false;
                } else if root.is_renaming {
                    root.is_renaming = false;
                } else if root.search_text != "" {
                    root.search_text = "";
                    root.search_changed("");
                }
                return accept;
            }
            return reject;
        }

        // Outer Window Border Frame
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.content_bg;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 1px;
                spacing: 0px;

                // =========================================================
                // 1. UNIFIED WINDOWS 11 TITLEBAR & TAB STRIP (NO TOP BORDER)
                // =========================================================
                Rectangle {
                    height: 42px;
                    background: Theme.titlebar_bg;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 0px;
                        padding-top: 0px;
                        padding-bottom: 0px;
                        spacing: 0px;

                        // Tabs Area (aligned to bottom of the 42px titlebar so active tab blends into row 2)
                        HorizontalLayout {
                            padding-top: 8px;
                            spacing: 3px;

                            for tab[idx] in root.tabs: Rectangle {
                                width: 200px;
                                height: 34px;
                                border-top-left-radius: 8px;
                                border-top-right-radius: 8px;
                                background: tab.is_active ? Theme.nav_bg : (tab_touch.has-hover ? Theme.hover_bg : transparent);

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 6px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 8px;

                                    FluentEntryIcon {
                                        y: (parent.height - self.height) / 2;
                                        is_dir: true;
                                        large: false;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: tab.title;
                                        font-size: 13px;
                                        font-weight: tab.is_active ? 600 : 400;
                                        color: tab.is_active ? Theme.text_primary : Theme.text_secondary;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }

                                    // Tab Close Button
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        background: close_touch.has-hover ? Theme.hover_bg : transparent;

                                        Text {
                                            text: "\u{E8BB}";
                                            font-family: "Segoe Fluent Icons";
                                            font-size: 9px;
                                            color: close_touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        close_touch := TouchArea {
                                            clicked => { root.tab_closed(idx); }
                                        }
                                    }
                                }

                                tab_touch := TouchArea {
                                    width: parent.width - 30px;
                                    height: parent.height;
                                    clicked => { root.tab_selected(idx); }
                                }
                            }

                            // New Tab (+) Button next to tabs
                            Rectangle {
                                width: 32px;
                                height: 28px;
                                y: 3px;
                                border-radius: 5px;
                                background: new_tab_touch.has-hover ? Theme.hover_bg : transparent;

                                Text {
                                    text: "\u{E710}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 12px;
                                    color: Theme.text_primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                new_tab_touch := TouchArea {
                                    clicked => { root.tab_new(); }
                                }
                            }
                        }

                        // Draggable Titlebar Region
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 42px;
                            background: transparent;

                            TouchArea {
                                double-clicked => { root.window_maximize(); }
                                pointer-event(pe) => {
                                    if pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down {
                                        root.window_drag();
                                    }
                                }
                            }
                        }

                        // Top-Right Windows 11 Caption Controls (Minimize, Maximize, Close)
                        HorizontalLayout {
                            spacing: 0px;
                            padding-bottom: 10px;

                            CaptionButton {
                                icon: "\u{E921}";
                                clicked => { root.window_minimize(); }
                            }

                            CaptionButton {
                                icon: "\u{E922}";
                                clicked => { root.window_maximize(); }
                            }

                            CaptionButton {
                                icon: "\u{E8BB}";
                                is_close: true;
                                clicked => { root.window_close(); }
                            }
                        }
                    }
                }

                // =========================================================
                // 2. NAVIGATION & BREADCRUMB ADDRESS BAR ROW
                // =========================================================
                Rectangle {
                    height: 48px;
                    background: Theme.nav_bg;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 6px;

                        FluentIconButton {
                            icon: "\u{E72B}";
                            is_disabled: !root.can_go_back;
                            clicked => { root.nav_back(); }
                        }

                        FluentIconButton {
                            icon: "\u{E72A}";
                            is_disabled: !root.can_go_forward;
                            clicked => { root.nav_forward(); }
                        }

                        FluentIconButton {
                            icon: "\u{E74A}";
                            clicked => { root.nav_up(); }
                        }

                        FluentIconButton {
                            icon: "\u{E72C}";
                            clicked => { root.nav_refresh(); }
                        }

                        // Breadcrumb / Address Bar (Larger, Brighter 14px Typography)
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 34px;
                            border-radius: 5px;
                            background: Theme.input_bg;
                            border-width: 1px;
                            border-color: root.is_editing_path ? Theme.accent : Theme.border;

                            if !root.is_editing_path: HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                padding-top: 3px;
                                padding-bottom: 3px;
                                spacing: 2px;

                                // Computer / Root glyph
                                Text {
                                    width: 20px;
                                    text: root.active_nav_key == "network" ? "\u{E774}" : "\u{EC4E}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 14px;
                                    color: Theme.text_secondary;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    width: 14px;
                                    text: "\u{E76C}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 10px;
                                    color: Theme.text_muted;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }

                                for crumb[c_idx] in root.crumbs: HorizontalLayout {
                                    spacing: 2px;

                                    Rectangle {
                                        height: 26px;
                                        border-radius: 4px;
                                        background: crumb_touch.has-hover ? Theme.hover_bg : transparent;

                                        HorizontalLayout {
                                            padding-left: 7px;
                                            padding-right: 7px;

                                            Text {
                                                text: crumb.label;
                                                font-size: 14px;
                                                font-weight: c_idx == root.crumbs.length - 1 ? 600 : 400;
                                                color: Theme.text_primary;
                                                vertical-alignment: center;
                                            }
                                        }

                                        crumb_touch := TouchArea {
                                            clicked => { root.nav_to_path(crumb.path); }
                                        }
                                    }

                                    Text {
                                        width: 14px;
                                        text: "\u{E76C}";
                                        font-family: "Segoe Fluent Icons";
                                        font-size: 10px;
                                        color: Theme.text_muted;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                // Trailing empty space in address bar: click to edit raw path (or type \\nas\share)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                    TouchArea {
                                        clicked => {
                                            root.raw_path_text = root.current_path;
                                            root.is_editing_path = true;
                                        }
                                    }
                                }
                            }

                            if root.is_editing_path: HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;

                                LineEdit {
                                    horizontal-stretch: 1;
                                    font-size: 14px;
                                    placeholder-text: "Enter folder path or \\\\server\\share...";
                                    text <=> root.raw_path_text;
                                    accepted(text) => {
                                        root.is_editing_path = false;
                                        root.nav_to_path(text);
                                        key_scope.focus();
                                    }
                                }

                                FluentIconButton {
                                    width: 28px;
                                    height: 28px;
                                    icon: "\u{E8BB}";
                                    clicked => {
                                        root.is_editing_path = false;
                                        key_scope.focus();
                                    }
                                }
                            }
                        }

                        // Windows 11 Search Box
                        Rectangle {
                            width: 280px;
                            height: 34px;
                            border-radius: 5px;
                            background: Theme.input_bg;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 6px;

                                search_input := LineEdit {
                                    horizontal-stretch: 1;
                                    font-size: 13.5px;
                                    placeholder-text: "Search " + root.current_folder_name;
                                    text <=> root.search_text;
                                    edited(text) => {
                                        root.search_changed(text);
                                    }
                                    accepted(text) => {
                                        root.search_changed(text);
                                    }
                                }

                                if root.search_text != "": Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: clear_search_touch.has-hover ? Theme.hover_bg : transparent;

                                    Text {
                                        text: "\u{E8BB}";
                                        font-family: "Segoe Fluent Icons";
                                        font-size: 9px;
                                        color: Theme.text_primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    clear_search_touch := TouchArea {
                                        clicked => {
                                            root.search_text = "";
                                            root.search_changed("");
                                            key_scope.focus();
                                        }
                                    }
                                }

                                Text {
                                    width: 18px;
                                    text: "\u{E721}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 13px;
                                    color: Theme.text_secondary;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Subtle separator between Navigation Row and Command Bar
                Rectangle { height: 1px; background: Theme.divider; }

                // =========================================================
                // 3. WINDOWS 11 COMMAND BAR
                // =========================================================
                Rectangle {
                    height: 46px;
                    background: Theme.cmd_bg;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 4px;

                        CommandBarButton {
                            icon: "\u{E710}";
                            icon_tint: Theme.accent;
                            label: "New";
                            has_dropdown: true;
                            is_active: root.active_flyout == "new";
                            clicked => {
                                root.active_flyout = root.active_flyout == "new" ? "" : "new";
                            }
                        }

                        Rectangle {
                            width: 1px;
                            height: 22px;
                            y: 7px;
                            background: Theme.divider;
                        }

                        CommandBarButton {
                            icon: "\u{E8C6}";
                            is_disabled: root.selected_index < 0;
                            clicked => { root.command_cut(); }
                        }

                        CommandBarButton {
                            icon: "\u{E8C8}";
                            is_disabled: root.selected_index < 0;
                            clicked => { root.command_copy(); }
                        }

                        CommandBarButton {
                            icon: "\u{E77F}";
                            clicked => { root.command_paste(); }
                        }

                        CommandBarButton {
                            icon: "\u{E8AC}";
                            is_disabled: root.selected_index < 0;
                            clicked => { root.command_rename(); }
                        }

                        CommandBarButton {
                            icon: "\u{E74D}";
                            is_disabled: root.selected_index < 0;
                            clicked => { root.command_delete(); }
                        }

                        Rectangle {
                            width: 1px;
                            height: 22px;
                            y: 7px;
                            background: Theme.divider;
                        }

                        CommandBarButton {
                            icon: "\u{E8CB}";
                            icon_tint: Theme.accent;
                            label: "Sort";
                            has_dropdown: true;
                            is_active: root.active_flyout == "sort";
                            clicked => {
                                root.active_flyout = root.active_flyout == "sort" ? "" : "sort";
                            }
                        }

                        CommandBarButton {
                            icon: root.view_mode == "details" ? "\u{E8FD}" : "\u{E8A9}";
                            label: "View";
                            has_dropdown: true;
                            is_active: root.active_flyout == "view";
                            clicked => {
                                root.active_flyout = root.active_flyout == "view" ? "" : "view";
                            }
                        }

                        // Connect to NAS / Map Network Drive quick button when in Network view
                        if root.active_nav_key == "network": CommandBarButton {
                            icon: "\u{E774}";
                            icon_tint: Theme.accent;
                            label: "Map network drive";
                            clicked => { root.command_map_network_drive(); }
                        }

                        // Flexible middle spacer pushing Details/Preview to the right
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        CommandBarButton {
                            icon: "\u{E946}";
                            icon_tint: root.show_details ? Theme.accent : Theme.text_primary;
                            label: "Details";
                            is_active: root.show_details;
                            clicked => { root.command_toggle_details(); }
                        }

                        CommandBarButton {
                            icon: "\u{E890}";
                            icon_tint: root.show_preview ? Theme.accent : Theme.text_primary;
                            label: "Preview";
                            is_active: root.show_preview;
                            clicked => { root.command_toggle_preview(); }
                        }
                    }
                }

                // Separator below Command Bar
                Rectangle { height: 1px; background: Theme.divider; }

                // =========================================================
                // 4. MAIN WORKSPACE (Sidebar + Folder View + Preview/Details)
                // =========================================================
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;

                    // Left Navigation Sidebar
                    Rectangle {
                        width: 240px;
                        background: Theme.sidebar_bg;

                        ScrollView {
                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 8px;
                                padding-bottom: 12px;
                                spacing: 2px;

                                NavItem {
                                    icon: "\u{E80F}";
                                    icon_color: #60cdff;
                                    label: "Home";
                                    is_selected: root.active_nav_key == "home";
                                    clicked => { root.nav_to_path("home"); }
                                }

                                NavItem {
                                    icon: "\u{EB9F}";
                                    icon_color: #c58af9;
                                    label: "Gallery";
                                    is_selected: root.active_nav_key == "pictures";
                                    clicked => { root.nav_to_path("pictures"); }
                                }

                                Rectangle {
                                    height: 9px;
                                    Rectangle {
                                        x: 8px;
                                        y: 4px;
                                        width: parent.width - 16px;
                                        height: 1px;
                                        background: Theme.divider;
                                    }
                                }

                                NavItem {
                                    icon: "\u{E8FC}";
                                    icon_color: #4cc2ff;
                                    label: "Desktop";
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "desktop";
                                    clicked => { root.nav_to_path("desktop"); }
                                }

                                NavItem {
                                    icon: "\u{E896}";
                                    icon_color: #28c76f;
                                    label: "Downloads";
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "downloads";
                                    clicked => { root.nav_to_path("downloads"); }
                                }

                                NavItem {
                                    icon: "\u{E8A5}";
                                    icon_color: #b4a0ff;
                                    label: "Documents";
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "documents";
                                    clicked => { root.nav_to_path("documents"); }
                                }

                                NavItem {
                                    icon: "\u{EB9F}";
                                    icon_color: #ff9f43;
                                    label: "Pictures";
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "pictures_folder";
                                    clicked => { root.nav_to_path("pictures"); }
                                }

                                NavItem {
                                    icon: "\u{E8D6}";
                                    icon_color: #ff6b8b;
                                    label: "Music";
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "music";
                                    clicked => { root.nav_to_path("music"); }
                                }

                                NavItem {
                                    icon: "\u{E8B2}";
                                    icon_color: #00cfe8;
                                    label: "Videos";
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "videos";
                                    clicked => { root.nav_to_path("videos"); }
                                }

                                Rectangle {
                                    height: 11px;
                                    Rectangle {
                                        x: 8px;
                                        y: 5px;
                                        width: parent.width - 16px;
                                        height: 1px;
                                        background: Theme.divider;
                                    }
                                }

                                // This PC Section Header
                                HorizontalLayout {
                                    height: 30px;
                                    padding-left: 10px;
                                    spacing: 8px;

                                    Text {
                                        width: 18px;
                                        text: "\u{EC4E}";
                                        font-family: "Segoe Fluent Icons";
                                        font-size: 14px;
                                        color: Theme.text_secondary;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: "This PC";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.text_primary;
                                        vertical-alignment: center;
                                    }
                                }

                                for drive in root.drives: Rectangle {
                                    height: 54px;
                                    border-radius: 5px;
                                    background: root.current_path == drive.letter ? Theme.row_selected : (drive_touch.has-hover ? Theme.row_hover : transparent);

                                    if root.current_path == drive.letter: Rectangle {
                                        x: 2px;
                                        y: 15px;
                                        width: 3px;
                                        height: 24px;
                                        border-radius: 1.5px;
                                        background: Theme.accent;
                                    }

                                    VerticalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 10px;

                                            Text {
                                                width: 18px;
                                                text: "\u{EDA2}";
                                                font-family: "Segoe Fluent Icons";
                                                font-size: 16px;
                                                color: Theme.accent;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 1px;

                                                Text {
                                                    text: drive.name;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                    color: Theme.text_primary;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: drive.free_str + " free of " + drive.total_str;
                                                    font-size: 11px;
                                                    color: Theme.text_secondary;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }
                                            }
                                        }

                                        // Drive Storage Bar
                                        Rectangle {
                                            height: 4px;
                                            border-radius: 2px;
                                            background: Theme.border;

                                            Rectangle {
                                                x: 0px;
                                                width: parent.width * drive.percent_used;
                                                height: parent.height;
                                                border-radius: 2px;
                                                background: drive.percent_used > 0.9 ? #f85149 : Theme.accent;
                                            }
                                        }
                                    }

                                    drive_touch := TouchArea {
                                        clicked => { root.nav_to_path(drive.letter); }
                                    }
                                }

                                Rectangle {
                                    height: 11px;
                                    Rectangle {
                                        x: 8px;
                                        y: 5px;
                                        width: parent.width - 16px;
                                        height: 1px;
                                        background: Theme.divider;
                                    }
                                }

                                // Network / NAS Section
                                NavItem {
                                    icon: "\u{E774}";
                                    icon_color: #60cdff;
                                    label: "Network";
                                    is_selected: root.active_nav_key == "network";
                                    clicked => { root.nav_to_path("network"); }
                                }
                            }
                        }
                    }

                    // Vertical Divider between Navigation Pane and Content View
                    Rectangle { width: 1px; background: Theme.divider; }

                    // Center Folder Content View
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.content_bg;

                        VerticalLayout {
                            spacing: 0px;

                            // Table Column Headers (Details View)
                            if root.view_mode == "details": Rectangle {
                                height: 36px;
                                background: Theme.content_bg;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 20px;
                                    spacing: 12px;

                                    // Name Header
                                    Rectangle {
                                        horizontal-stretch: 4;
                                        background: name_hdr_touch.has-hover ? Theme.row_hover : transparent;
                                        border-radius: 4px;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Text {
                                                text: "Name";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: root.sort_column == "name" ? Theme.text_primary : Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                            }

                                            if root.sort_column == "name": Text {
                                                text: root.sort_asc ? "\u{E70E}" : "\u{E70D}";
                                                font-family: "Segoe Fluent Icons";
                                                font-size: 10px;
                                                color: Theme.accent;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        name_hdr_touch := TouchArea {
                                            clicked => { root.sort_by("name"); }
                                        }
                                    }

                                    Rectangle { width: 1px; height: 18px; y: 9px; background: Theme.divider; }

                                    // Date modified Header
                                    Rectangle {
                                        width: 160px;
                                        background: date_hdr_touch.has-hover ? Theme.row_hover : transparent;
                                        border-radius: 4px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            spacing: 6px;

                                            Text {
                                                text: "Date modified";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: root.sort_column == "date" ? Theme.text_primary : Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                            }

                                            if root.sort_column == "date": Text {
                                                text: root.sort_asc ? "\u{E70E}" : "\u{E70D}";
                                                font-family: "Segoe Fluent Icons";
                                                font-size: 10px;
                                                color: Theme.accent;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        date_hdr_touch := TouchArea {
                                            clicked => { root.sort_by("date"); }
                                        }
                                    }

                                    Rectangle { width: 1px; height: 18px; y: 9px; background: Theme.divider; }

                                    // Type Header
                                    Rectangle {
                                        width: 190px;
                                        background: type_hdr_touch.has-hover ? Theme.row_hover : transparent;
                                        border-radius: 4px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            spacing: 6px;

                                            Text {
                                                text: "Type";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: root.sort_column == "type" ? Theme.text_primary : Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                            }

                                            if root.sort_column == "type": Text {
                                                text: root.sort_asc ? "\u{E70E}" : "\u{E70D}";
                                                font-family: "Segoe Fluent Icons";
                                                font-size: 10px;
                                                color: Theme.accent;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        type_hdr_touch := TouchArea {
                                            clicked => { root.sort_by("type"); }
                                        }
                                    }

                                    Rectangle { width: 1px; height: 18px; y: 9px; background: Theme.divider; }

                                    // Size Header
                                    Rectangle {
                                        width: 100px;
                                        background: size_hdr_touch.has-hover ? Theme.row_hover : transparent;
                                        border-radius: 4px;

                                        HorizontalLayout {
                                            padding-right: 6px;
                                            spacing: 6px;

                                            Rectangle { horizontal-stretch: 1; }

                                            if root.sort_column == "size": Text {
                                                text: root.sort_asc ? "\u{E70E}" : "\u{E70D}";
                                                font-family: "Segoe Fluent Icons";
                                                font-size: 10px;
                                                color: Theme.accent;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: "Size";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: root.sort_column == "size" ? Theme.text_primary : Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: right;
                                            }
                                        }

                                        size_hdr_touch := TouchArea {
                                            clicked => { root.sort_by("size"); }
                                        }
                                    }
                                }
                            }

                            if root.view_mode == "details": Rectangle { height: 1px; background: Theme.divider; }

                            // Details List Rows (36px height, 14px bright primary text, 13px secondary text)
                            if root.view_mode == "details": ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 12px;
                                    padding-top: 4px;
                                    padding-bottom: 8px;
                                    spacing: 2px;

                                    if root.entries.length == 0: Rectangle {
                                        height: 140px;
                                        Text {
                                            text: root.search_text != "" ? "No items match your search." : (root.active_nav_key == "network" ? "No connected network shares found. Click 'Map network drive' or type \\\\server\\share in the address bar." : "This folder is empty.");
                                            font-size: 14px;
                                            color: Theme.text_secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    for entry[e_idx] in root.entries: Rectangle {
                                        height: 36px;
                                        border-radius: 5px;
                                        background: root.selected_index == e_idx ? Theme.row_selected : (row_touch.has-hover ? Theme.row_hover : transparent);

                                        // Windows 11 Left Blue Selection Pill
                                        if root.selected_index == e_idx: Rectangle {
                                            x: 2px;
                                            y: 9px;
                                            width: 3px;
                                            height: 18px;
                                            border-radius: 1.5px;
                                            background: Theme.accent;
                                        }

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 8px;
                                            spacing: 12px;

                                            // Name + Authentic Windows 11 Icon (or Inline Rename Editor)
                                            HorizontalLayout {
                                                horizontal-stretch: 4;
                                                spacing: 10px;

                                                FluentEntryIcon {
                                                    y: (parent.height - self.height) / 2;
                                                    is_dir: entry.is_dir;
                                                    glyph: entry.icon_glyph;
                                                    glyph_color: entry.icon_color;
                                                    large: false;
                                                }

                                                if !(root.is_renaming && root.selected_index == e_idx): Text {
                                                    horizontal-stretch: 1;
                                                    text: entry.name;
                                                    font-size: 14px;
                                                    font-weight: root.selected_index == e_idx ? 500 : 400;
                                                    color: Theme.text_primary;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }

                                                if root.is_renaming && root.selected_index == e_idx: HorizontalLayout {
                                                    horizontal-stretch: 1;
                                                    padding-top: 3px;
                                                    padding-bottom: 3px;
                                                    spacing: 6px;

                                                    LineEdit {
                                                        horizontal-stretch: 1;
                                                        font-size: 13.5px;
                                                        text <=> root.rename_text;
                                                        accepted(new_name) => {
                                                            root.is_renaming = false;
                                                            root.command_commit_rename(new_name);
                                                            key_scope.focus();
                                                        }
                                                    }
                                                }
                                            }

                                            // Spacer matching header separator
                                            Rectangle { width: 1px; }

                                            // Date modified
                                            Text {
                                                width: 160px;
                                                text: entry.mtime_str;
                                                font-size: 13px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                            }

                                            Rectangle { width: 1px; }

                                            // Type
                                            Text {
                                                width: 190px;
                                                text: entry.type_str;
                                                font-size: 13px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                            }

                                            Rectangle { width: 1px; }

                                            // Size
                                            Text {
                                                width: 100px;
                                                text: entry.size_str;
                                                font-size: 13px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: right;
                                                overflow: elide;
                                            }
                                        }

                                        row_touch := TouchArea {
                                            enabled: !(root.is_renaming && root.selected_index == e_idx);
                                            clicked => {
                                                key_scope.focus();
                                                root.item_clicked(e_idx);
                                            }
                                            double-clicked => {
                                                root.item_double_clicked(e_idx);
                                            }
                                            pointer-event(pe) => {
                                                if pe.button == PointerEventButton.right && pe.kind == PointerEventKind.down {
                                                    root.item_clicked(e_idx);
                                                    root.item_right_clicked(e_idx);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Non-Details Views (Extra large, Large, Medium Icons, Tiles, List, Content)
                            if root.view_mode != "details": ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;

                                    for entry[e_idx] in root.entries: Rectangle {
                                        height: root.view_mode == "xl_icons" ? 84px : (root.view_mode == "list" ? 34px : 66px);
                                        border-radius: 6px;
                                        background: root.selected_index == e_idx ? Theme.row_selected : (grid_touch.has-hover ? Theme.row_hover : transparent);

                                        if root.selected_index == e_idx: Rectangle {
                                            x: 2px;
                                            y: 12px;
                                            width: 3px;
                                            height: parent.height - 24px;
                                            border-radius: 1.5px;
                                            background: Theme.accent;
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 14px;

                                            FluentEntryIcon {
                                                y: (parent.height - self.height) / 2;
                                                is_dir: entry.is_dir;
                                                glyph: entry.icon_glyph;
                                                glyph_color: entry.icon_color;
                                                large: root.view_mode != "list" && root.view_mode != "small_icons";
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-top: root.view_mode == "list" ? 6px : 12px;
                                                padding-bottom: root.view_mode == "list" ? 6px : 12px;
                                                spacing: 3px;

                                                Text {
                                                    text: entry.name;
                                                    font-size: 14px;
                                                    font-weight: 500;
                                                    color: Theme.text_primary;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }

                                                if root.view_mode != "list": Text {
                                                    text: entry.type_str + (entry.size_str != "" ? "  •  " + entry.size_str : "") + (entry.mtime_str != "" ? "  •  " + entry.mtime_str : "");
                                                    font-size: 12.5px;
                                                    color: Theme.text_secondary;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }
                                            }
                                        }

                                        grid_touch := TouchArea {
                                            clicked => {
                                                key_scope.focus();
                                                root.item_clicked(e_idx);
                                            }
                                            double-clicked => {
                                                root.item_double_clicked(e_idx);
                                            }
                                            pointer-event(pe) => {
                                                if pe.button == PointerEventButton.right && pe.kind == PointerEventKind.down {
                                                    root.item_clicked(e_idx);
                                                    root.item_right_clicked(e_idx);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // =========================================================
                    // RIGHT PREVIEW PANE (PDF Visual + Text, Images, Excel, Word, Code)
                    // =========================================================
                    if root.show_preview: Rectangle {
                        width: 1px;
                        background: Theme.divider;
                    }

                    if root.show_preview: Rectangle {
                        width: 380px;
                        background: Theme.pane_bg;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                height: 36px;
                                spacing: 10px;

                                Text {
                                    width: 22px;
                                    text: "\u{E890}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 16px;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;

                                    Text {
                                        text: root.preview_title != "" ? root.preview_title : "Preview Pane";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Theme.text_primary;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.preview_subtitle;
                                        font-size: 12px;
                                        color: Theme.text_secondary;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }
                                }

                                FluentIconButton {
                                    icon: "\u{E8BB}";
                                    clicked => { root.command_toggle_preview(); }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.divider; }

                            // High-Resolution Visual Thumbnail / PDF Page / Image Render
                            if root.has_preview_image: Rectangle {
                                height: root.preview_type == "image" ? 320px : 210px;
                                border-radius: 6px;
                                background: Theme.content_bg;
                                border-width: 1px;
                                border-color: Theme.border;

                                Image {
                                    width: parent.width - 12px;
                                    height: parent.height - 12px;
                                    x: 6px;
                                    y: 6px;
                                    source: root.preview_image;
                                    image-fit: contain;
                                }
                            }

                            // Spreadsheet / Table Preview (Excel & CSV)
                            if root.preview_type == "table": ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 2px;

                                    Rectangle {
                                        height: 28px;
                                        background: Theme.nav_bg;
                                        border-radius: 4px;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            for h in root.preview_table_headers: Text {
                                                width: 90px;
                                                text: h;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: Theme.accent;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    for row in root.preview_table_rows: Rectangle {
                                        height: 26px;
                                        background: Theme.content_bg;
                                        border-radius: 3px;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            for cell in row.cells: Text {
                                                width: 90px;
                                                text: cell;
                                                font-size: 12px;
                                                color: Theme.text_primary;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }

                            // PDF Text / Word / PowerPoint / Code / Markdown Preview
                            if root.preview_type == "text" || root.preview_type == "image": ScrollView {
                                vertical-stretch: 1;
                                Text {
                                    text: root.preview_text_content;
                                    font-family: "Segoe UI Variable Text";
                                    font-size: 13px;
                                    color: Theme.text_primary;
                                    wrap: word-wrap;
                                }
                            }

                            if root.preview_type == "none": Rectangle {
                                vertical-stretch: 1;
                                Text {
                                    text: "Select a file to preview its contents.";
                                    font-size: 13.5px;
                                    color: Theme.text_secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // =========================================================
                    // RIGHT DETAILS PANE (Windows 11 Hero Card + Structured Metadata)
                    // =========================================================
                    if root.show_details: Rectangle {
                        width: 1px;
                        background: Theme.divider;
                    }

                    if root.show_details: Rectangle {
                        width: 320px;
                        background: Theme.pane_bg;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                height: 32px;
                                spacing: 10px;

                                Text {
                                    width: 20px;
                                    text: "\u{E946}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 16px;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: "Details";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }

                                FluentIconButton {
                                    icon: "\u{E8BB}";
                                    clicked => { root.command_toggle_details(); }
                                }
                            }

                            // Hero Header Card for Selected Item
                            if root.selected_index >= 0: Rectangle {
                                height: root.has_preview_image ? 170px : 84px;
                                border-radius: 6px;
                                background: Theme.content_bg;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;

                                    if root.has_preview_image: Image {
                                        height: 96px;
                                        source: root.preview_image;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: root.preview_title;
                                        font-size: 14.5px;
                                        font-weight: 600;
                                        color: Theme.text_primary;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.preview_subtitle;
                                        font-size: 12.5px;
                                        color: Theme.text_secondary;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.divider; }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 10px;

                                    if root.item_properties.length == 0: Text {
                                        text: "Select a file or folder to view its detailed properties.";
                                        font-size: 13px;
                                        color: Theme.text_secondary;
                                        wrap: word-wrap;
                                    }

                                    for prop in root.item_properties: VerticalLayout {
                                        spacing: 3px;
                                        Text {
                                            text: prop.name;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text_secondary;
                                            horizontal-alignment: left;
                                        }
                                        Text {
                                            text: prop.value;
                                            font-size: 13.5px;
                                            color: Theme.text_primary;
                                            horizontal-alignment: left;
                                            wrap: word-wrap;
                                        }
                                        Rectangle { height: 1px; background: Theme.divider; }
                                    }
                                }
                            }
                        }
                    }
                }

                // =========================================================
                // 5. WINDOWS 11 STATUS BAR
                // =========================================================
                Rectangle { height: 1px; background: Theme.divider; }

                Rectangle {
                    height: 30px;
                    background: Theme.sidebar_bg;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 10px;
                        spacing: 14px;

                        Text {
                            text: root.status_item_count;
                            font-size: 12px;
                            color: Theme.text_secondary;
                            vertical-alignment: center;
                        }

                        if root.status_selection_info != "": Rectangle {
                            width: 1px;
                            height: 14px;
                            y: 8px;
                            background: Theme.border;
                        }

                        if root.status_selection_info != "": Text {
                            text: root.status_selection_info;
                            font-size: 12px;
                            color: Theme.text_primary;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        FluentIconButton {
                            width: 26px;
                            height: 26px;
                            y: 2px;
                            icon: "\u{E8FD}";
                            is_active: root.view_mode == "details";
                            clicked => { root.command_set_view("details"); }
                        }

                        FluentIconButton {
                            width: 26px;
                            height: 26px;
                            y: 2px;
                            icon: "\u{E8A9}";
                            is_active: root.view_mode != "details";
                            clicked => { root.command_set_view("icons"); }
                        }
                    }
                }
            }

            // =========================================================
            // 6. FLOATING WINDOWS 11 COMMAND BAR FLYOUT MENUS (NEW, SORT, VIEW)
            // =========================================================
            if root.active_flyout != "": TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.active_flyout = ""; }
            }

            // "+ New" Flyout Menu
            if root.active_flyout == "new": Rectangle {
                x: 12px;
                y: 136px;
                width: 245px;
                height: 162px;
                border-radius: 8px;
                background: Theme.flyout_bg;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;

                    FlyoutMenuItem {
                        icon: "\u{E8B7}";
                        icon_color: #f5ba18;
                        label: "Folder";
                        clicked => {
                            root.active_flyout = "";
                            root.command_new_folder();
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        icon: "\u{E8A5}";
                        icon_color: #60cdff;
                        label: "Text Document (.txt)";
                        clicked => {
                            root.active_flyout = "";
                            root.command_new_file("New Text Document.txt");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E943}";
                        icon_color: #b4a0ff;
                        label: "Markdown Note (.md)";
                        clicked => {
                            root.active_flyout = "";
                            root.command_new_file("Notes.md");
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        icon: "\u{E774}";
                        icon_color: #28c76f;
                        label: "Map Network Drive (NAS)...";
                        clicked => {
                            root.active_flyout = "";
                            root.command_map_network_drive();
                        }
                    }
                }
            }

            // "Sort" Flyout Menu (Exact replica of Screenshot 1)
            if root.active_flyout == "sort": Rectangle {
                x: 310px;
                y: 136px;
                width: 215px;
                height: 246px;
                border-radius: 8px;
                background: Theme.flyout_bg;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;

                    FlyoutMenuItem {
                        label: "Name";
                        is_checked: root.sort_column == "name";
                        clicked => {
                            root.active_flyout = "";
                            root.sort_by("name");
                        }
                    }

                    FlyoutMenuItem {
                        label: "Date modified";
                        is_checked: root.sort_column == "date";
                        clicked => {
                            root.active_flyout = "";
                            root.sort_by("date");
                        }
                    }

                    FlyoutMenuItem {
                        label: "Type";
                        is_checked: root.sort_column == "type";
                        clicked => {
                            root.active_flyout = "";
                            root.sort_by("type");
                        }
                    }

                    FlyoutMenuItem {
                        label: "Size";
                        is_checked: root.sort_column == "size";
                        clicked => {
                            root.active_flyout = "";
                            root.sort_by("size");
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        label: "Ascending";
                        is_checked: root.sort_asc;
                        clicked => {
                            root.active_flyout = "";
                            root.sort_direction(true);
                        }
                    }

                    FlyoutMenuItem {
                        label: "Descending";
                        is_checked: !root.sort_asc;
                        clicked => {
                            root.active_flyout = "";
                            root.sort_direction(false);
                        }
                    }
                }
            }

            // "View" Flyout Menu (Exact replica of Screenshot 2)
            if root.active_flyout == "view": Rectangle {
                x: 392px;
                y: 136px;
                width: 250px;
                height: 416px;
                border-radius: 8px;
                background: Theme.flyout_bg;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;

                    FlyoutMenuItem {
                        icon: "\u{E740}";
                        label: "Extra large icons";
                        is_checked: root.view_mode == "xl_icons";
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("xl_icons");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E8A9}";
                        label: "Large icons";
                        is_checked: root.view_mode == "large_icons";
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("large_icons");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{F0E2}";
                        label: "Medium-sized icons";
                        is_checked: root.view_mode == "icons";
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("icons");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E80A}";
                        label: "Small icons";
                        is_checked: root.view_mode == "small_icons";
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("small_icons");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E8FD}";
                        label: "List";
                        is_checked: root.view_mode == "list";
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("list");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E8FD}";
                        label: "Details";
                        is_checked: root.view_mode == "details";
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("details");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{ECA5}";
                        label: "Tiles";
                        is_checked: root.view_mode == "tiles";
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("tiles");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E8FD}";
                        label: "Content";
                        is_checked: root.view_mode == "content";
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("content");
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        icon: "\u{E946}";
                        icon_color: Theme.accent;
                        label: "Details pane";
                        is_checked: root.show_details;
                        clicked => {
                            root.active_flyout = "";
                            root.command_toggle_details();
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E890}";
                        icon_color: Theme.accent;
                        label: "Preview pane";
                        is_checked: root.show_preview;
                        clicked => {
                            root.active_flyout = "";
                            root.command_toggle_preview();
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        icon: "\u{E7B3}";
                        label: "Hidden items";
                        is_checked: root.show_hidden;
                        clicked => {
                            root.active_flyout = "";
                            root.command_toggle_hidden();
                        }
                    }
                }
            }
        }
    }
}
