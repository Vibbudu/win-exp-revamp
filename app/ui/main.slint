import { ScrollView } from "std-widgets.slint";

export global Theme {
    in-out property <bool> is_dark: true;

    out property <color> titlebar_bg: is_dark ? #0c0c0c : #dfe3e8;
    out property <color> nav_bg: is_dark ? #202020 : #f3f3f3;
    out property <color> cmd_bg: is_dark ? #1c1c1c : #f8f8f8;
    out property <color> sidebar_bg: is_dark ? #191919 : #f0f2f5;
    out property <color> content_bg: is_dark ? #191919 : #ffffff;
    out property <color> pane_bg: is_dark ? #1c1c1c : #f7f8fa;
    out property <color> input_bg: is_dark ? #2b2b2b : #ffffff;
    out property <color> flyout_bg: is_dark ? #2c2c2c : #fcfcfc;

    out property <color> border: is_dark ? #383838 : #d0d5dd;
    out property <color> divider: is_dark ? #2c2c2c : #e2e5ea;

    out property <color> hover_bg: is_dark ? #323232 : #e4e7ec;
    out property <color> row_hover: is_dark ? #272727 : #f1f5f9;
    out property <color> row_selected: is_dark ? #2d333b : #e0eefb;

    out property <color> text_primary: is_dark ? #ffffff : #141414;
    out property <color> text_secondary: is_dark ? #cccccc : #424242;
    out property <color> text_muted: is_dark ? #999999 : #686868;
    out property <color> accent: is_dark ? #4cc2ff : #0067c0;
}

export struct EntryItem {
    id: string,
    name: string,
    path: string,
    is_dir: bool,
    size_str: string,
    mtime_str: string,
    type_str: string,
    icon_glyph: string,
    icon_color: color,
    has_thumb: bool,
    thumb: image,
    is_cloud: bool,
    orig_index: int,
}

export struct EntryGridRow {
    items: [EntryItem],
}

export struct DriveItem {
    letter: string,
    name: string,
    free_str: string,
    total_str: string,
    percent_used: float,
    is_cloud: bool,
}

export struct CrumbItem {
    label: string,
    path: string,
}

export struct TabItem {
    id: int,
    title: string,
    path: string,
    is_active: bool,
}

export struct PreviewRow {
    cells: [string],
}

export struct PropertyItem {
    name: string,
    value: string,
}

// Authentic Windows 11 Cloud Sync Overlay Badge (white cloud with #0078d4 blue outline)
component CloudSyncBadge inherits Rectangle {
    in property <bool> large: false;

    width: large ? 20px : 13px;
    height: large ? 14px : 10px;
    background: transparent;

    // Outer white outline pill
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.height / 2;
        background: #ffffff;
        border-width: 1.2px;
        border-color: #0078d4;

        Text {
            text: "\u{E753}";
            font-family: "Segoe Fluent Icons";
            font-size: large ? 11px : 8px;
            color: #0078d4;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Authentic Windows 11 Fluent 2-Tone Gold Folder Vector Icon, Shell Thumbnail, or File Glyph
component FluentEntryIcon inherits Rectangle {
    in property <bool> is_dir: true;
    in property <string> glyph: "\u{E8A5}";
    in property <color> glyph_color: #cccccc;
    in property <bool> has_thumb: false;
    in property <image> thumb;
    in property <bool> is_cloud: false;
    in property <int> icon_px: 16; // 16, 20, 32, 48, 72, 96

    width: icon_px * 1px + 4px;
    height: icon_px * 1px + 2px;
    background: transparent;

    // 1. Real Shell Thumbnail or Per-File Icon (when loaded from StaPool LruCache)
    if root.has_thumb: Image {
        width: parent.width;
        height: parent.height;
        source: root.thumb;
        image-fit: contain;
    }

    // 2. Authentic Windows 11 2-Tone Gold Vector Folder
    if !root.has_thumb && root.is_dir: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        // Back tab of Windows 11 folder
        Rectangle {
            x: 1px;
            y: parent.height * 0.08;
            width: parent.width * 0.42;
            height: parent.height * 0.25;
            border-radius: icon_px >= 32 ? 3px : 1.5px;
            background: #d9960a;
        }

        // Back plate of folder
        Rectangle {
            x: 1px;
            y: parent.height * 0.18;
            width: parent.width - 2px;
            height: parent.height * 0.72;
            border-radius: icon_px >= 32 ? 4px : 2px;
            background: #e3a414;
        }

        // Front bright gold plate of Windows 11 folder
        Rectangle {
            x: 1px;
            y: parent.height * 0.28;
            width: parent.width - 2px;
            height: parent.height * 0.64;
            border-radius: icon_px >= 32 ? 4px : 2px;
            background: @linear-gradient(180deg, #ffe074 0%, #f5ba18 100%);
        }
    }

    // 3. Crisp Document Card + Segoe Fluent Glyph for non-directory files without thumbnail
    if !root.has_thumb && !root.is_dir: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        if icon_px >= 32: Rectangle {
            x: parent.width * 0.12;
            y: 1px;
            width: parent.width * 0.76;
            height: parent.height - 2px;
            border-radius: 3px;
            background: #f5f5f5;
            border-width: 1px;
            border-color: #d0d0d0;
        }

        Text {
            text: root.glyph;
            font-family: "Segoe Fluent Icons";
            font-size: (icon_px * 0.78) * 1px;
            color: root.glyph_color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 4. Bottom-left Google Drive / Cloud Sync Overlay Badge
    if root.is_cloud: CloudSyncBadge {
        x: -1px;
        y: parent.height - self.height + 1px;
        large: root.icon_px >= 36;
    }
}

component FluentIconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> is_active: false;
    in property <bool> is_disabled: false;
    callback clicked();

    width: 30px;
    height: 28px;
    border-radius: 4px;
    background: is_disabled ? transparent : (touch.pressed ? Theme.divider : (touch.has-hover ? Theme.hover_bg : (is_active ? Theme.hover_bg : transparent)));

    Text {
        text: root.icon;
        font-family: "Segoe Fluent Icons";
        font-size: 12px;
        color: is_disabled ? Theme.text_muted : Theme.text_primary;
        opacity: is_disabled ? 0.40 : 1.0;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: !root.is_disabled;
        clicked => { root.clicked(); }
    }
}

component CaptionButton inherits Rectangle {
    in property <string> icon;
    in property <bool> is_close: false;
    callback clicked();

    width: 46px;
    height: 32px;
    background: touch.has-hover ? (root.is_close ? #c42b1c : Theme.hover_bg) : transparent;

    Text {
        text: root.icon;
        font-family: "Segoe Fluent Icons";
        font-size: 10px;
        color: touch.has-hover ? (root.is_close ? #ffffff : Theme.text_primary) : Theme.text_secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component CommandBarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label: "";
    in property <color> icon_tint: Theme.text_primary;
    in property <bool> is_active: false;
    in property <bool> has_dropdown: false;
    in property <bool> is_disabled: false;
    callback clicked();

    height: 32px;
    min-width: root.label == "" ? 34px : 68px;
    border-radius: 4px;
    background: is_disabled ? transparent : (touch.pressed ? Theme.divider : (touch.has-hover ? Theme.hover_bg : (is_active ? Theme.hover_bg : transparent)));
    border-width: is_active ? 1px : 0px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: root.label == "" ? 9px : 10px;
        padding-right: root.label == "" ? 9px : 10px;
        spacing: 7px;

        Text {
            text: root.icon;
            font-family: "Segoe Fluent Icons";
            font-size: 14px;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: is_disabled ? Theme.text_muted : root.icon_tint;
            opacity: is_disabled ? 0.4 : 1.0;
        }

        if root.label != "": Text {
            text: root.label;
            font-size: 12px;
            font-weight: 400;
            vertical-alignment: center;
            color: is_disabled ? Theme.text_muted : Theme.text_primary;
            opacity: is_disabled ? 0.4 : 1.0;
        }

        if root.has_dropdown: Text {
            text: "\u{E70D}";
            font-family: "Segoe Fluent Icons";
            font-size: 9px;
            vertical-alignment: center;
            color: Theme.text_secondary;
        }
    }

    touch := TouchArea {
        enabled: !root.is_disabled;
        clicked => { root.clicked(); }
    }
}

component FlyoutMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <color> icon_color: Theme.text_primary;
    in property <bool> is_checked: false;
    in property <bool> use_checkmark: false;
    in property <bool> has_chevron: false;
    callback clicked();
    callback hovered();

    height: 30px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.hover_bg : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;

        // Radio dot or Checkmark indicator column
        Rectangle {
            width: 14px;
            if root.is_checked && !root.use_checkmark: Rectangle {
                width: 4px;
                height: 4px;
                x: 5px;
                y: (parent.height - self.height) / 2;
                border-radius: 2px;
                background: Theme.text_primary;
            }
            if root.is_checked && root.use_checkmark: Text {
                text: "\u{E73E}";
                font-family: "Segoe Fluent Icons";
                font-size: 10px;
                color: Theme.text_primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.icon != "": Text {
            width: 18px;
            text: root.icon;
            font-family: "Segoe Fluent Icons";
            font-size: 14px;
            color: root.icon_color;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 12px;
            color: Theme.text_primary;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        if root.has_chevron: Text {
            width: 12px;
            text: "\u{E76C}";
            font-family: "Segoe Fluent Icons";
            font-size: 9px;
            color: Theme.text_secondary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        moved => { root.hovered(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <color> icon_color: #60cdff;
    in property <string> label;
    in property <bool> is_selected: false;
    in property <bool> is_pinned: false;
    in property <bool> compact: true;
    in property <bool> has_chevron: false;
    callback clicked();

    height: compact ? 26px : 32px;
    border-radius: 4px;
    background: is_selected ? Theme.row_selected : (touch.has-hover ? Theme.row_hover : transparent);

    // Windows 11 left accent selection indicator pill
    if root.is_selected: Rectangle {
        x: 2px;
        y: (parent.height - 14px) / 2;
        width: 3px;
        height: 14px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: has_chevron ? 6px : 18px;
        padding-right: 8px;
        spacing: 8px;

        if root.has_chevron: Text {
            width: 10px;
            text: "\u{E76C}";
            font-family: "Segoe Fluent Icons";
            font-size: 8px;
            color: Theme.text_muted;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        Text {
            width: 18px;
            text: root.icon;
            font-family: "Segoe Fluent Icons";
            font-size: 14px;
            color: root.icon_color;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 12px;
            font-weight: 400;
            vertical-alignment: center;
            horizontal-alignment: left;
            color: Theme.text_primary;
            overflow: elide;
        }

        if root.is_pinned: Text {
            width: 14px;
            text: "\u{E718}";
            font-family: "Segoe Fluent Icons";
            font-size: 10px;
            color: Theme.text_muted;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "File Explorer";
    no-frame: true;
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1320px;
    preferred-height: 800px;
    background: Theme.content_bg;
    default-font-family: "Segoe UI Variable Text";
    forward-focus: key_scope;

    // Theme synchronization with Windows 11 OS settings
    in-out property <bool> is_dark_mode <=> Theme.is_dark;

    // Windows 11 View -> Show toggles
    in-out property <bool> compact_view: true;
    in-out property <bool> show_nav_pane: true;
    in-out property <bool> item_check_boxes: false;
    in-out property <bool> show_file_extensions: true;
    in-out property <bool> show_hidden: true;

    // Resizable Column & Splitter widths
    in-out property <length> sidebar_width: 205px;
    in-out property <length> pane_width: 300px;
    in-out property <length> col_name_width: 310px;
    in-out property <length> col_date_width: 145px;
    in-out property <length> col_type_width: 155px;
    in-out property <length> col_size_width: 85px;

    // State properties
    in-out property <[TabItem]> tabs: [];
    in-out property <int> active_tab_index: 0;
    in-out property <[CrumbItem]> crumbs: [];
    in-out property <string> current_path: "";
    in-out property <string> current_folder_name: "Home";
    in-out property <string> active_nav_key: "home";
    in-out property <string> raw_path_text: "";
    in-out property <bool> is_editing_path: false;
    in-out property <string> search_text: "";

    // Flyout menu state ("", "new", "sort", "view") & cascading Show submenu
    in-out property <string> active_flyout: "";
    in-out property <bool> show_sub_flyout: false;

    // Inline Rename state
    in-out property <bool> is_renaming: false;
    in-out property <string> rename_text: "";

    in-out property <bool> can_go_back: false;
    in-out property <bool> can_go_forward: false;

    in-out property <[DriveItem]> drives: [];
    in-out property <[EntryItem]> entries: [];
    in-out property <[EntryGridRow]> grid_rows: [];
    in-out property <int> selected_index: -1;
    in-out property <string> selected_path: "";

    in-out property <string> view_mode: "details"; // "details", "tiles", "xl_icons", "large_icons", "icons", "small_icons", "list", "content"
    in-out property <string> sort_column: "name";
    in-out property <bool> sort_asc: true;

    in-out property <bool> show_preview: false;
    in-out property <bool> show_details: false;

    // Preview & Thumbnail Image state
    in-out property <string> preview_type: "none";
    in-out property <string> preview_title: "";
    in-out property <string> preview_subtitle: "";
    in-out property <string> preview_text_content: "";
    in-out property <bool> has_preview_image: false;
    in-out property <image> preview_image;
    in-out property <[string]> preview_table_headers: [];
    in-out property <[PreviewRow]> preview_table_rows: [];

    // Details pane state
    in-out property <[PropertyItem]> item_properties: [];

    // Status bar state
    in-out property <string> status_item_count: "0 items";
    in-out property <string> status_selection_info: "";

    // Window management callbacks
    callback window_minimize();
    callback window_maximize();
    callback window_close();
    callback window_drag();

    // Tab callbacks
    callback tab_selected(int);
    callback tab_closed(int);
    callback tab_new();

    // Navigation callbacks
    callback nav_back();
    callback nav_forward();
    callback nav_up();
    callback nav_refresh();
    callback nav_to_path(string);
    callback search_changed(string);

    // Item interaction callbacks
    callback item_clicked(int);
    callback item_double_clicked(int);
    callback item_right_clicked(int);
    callback item_drag_started(int);

    // Command bar callbacks
    callback command_new_folder();
    callback command_new_file(string);
    callback command_map_network_drive();
    callback command_cut();
    callback command_copy();
    callback command_paste();
    callback command_rename();
    callback command_commit_rename(string);
    callback command_delete();
    callback command_toggle_view();
    callback command_set_view(string);
    callback command_toggle_preview();
    callback command_toggle_details();
    callback command_toggle_hidden();
    callback command_toggle_compact();
    callback command_toggle_extensions();
    callback sort_by(string);
    callback sort_direction(bool);

    // Keyboard shortcut callback
    callback key_shortcut(string);

    key_scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.modifiers.control {
                if event.text == "t" || event.text == "T" {
                    root.tab_new();
                    return accept;
                }
                if event.text == "w" || event.text == "W" {
                    root.tab_closed(root.active_tab_index);
                    return accept;
                }
                if event.text == "l" || event.text == "L" {
                    root.raw_path_text = root.current_path;
                    root.is_editing_path = true;
                    return accept;
                }
                if event.text == "f" || event.text == "F" {
                    search_input.focus();
                    return accept;
                }
                if event.text == "c" || event.text == "C" {
                    root.command_copy();
                    return accept;
                }
                if event.text == "x" || event.text == "X" {
                    root.command_cut();
                    return accept;
                }
                if event.text == "v" || event.text == "V" {
                    root.command_paste();
                    return accept;
                }
                if event.text == "r" || event.text == "R" {
                    root.nav_refresh();
                    return accept;
                }
                if event.text == "n" || event.text == "N" {
                    root.command_new_folder();
                    return accept;
                }
            }
            if event.modifiers.alt {
                if event.text == Key.LeftArrow {
                    root.nav_back();
                    return accept;
                }
                if event.text == Key.RightArrow {
                    root.nav_forward();
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.nav_up();
                    return accept;
                }
                if event.text == "p" || event.text == "P" {
                    root.command_toggle_preview();
                    return accept;
                }
                if event.text == "d" || event.text == "D" {
                    root.raw_path_text = root.current_path;
                    root.is_editing_path = true;
                    return accept;
                }
            }
            if event.text == Key.F5 {
                root.nav_refresh();
                return accept;
            }
            if event.text == Key.F2 {
                root.command_rename();
                return accept;
            }
            if event.text == Key.Delete {
                root.command_delete();
                return accept;
            }
            if event.text == Key.Backspace && !root.is_editing_path && !root.is_renaming {
                root.nav_up();
                return accept;
            }
            if event.text == Key.Return && !root.is_editing_path && !root.is_renaming {
                if root.selected_index >= 0 {
                    root.item_double_clicked(root.selected_index);
                }
                return accept;
            }
            if event.text == Key.UpArrow && !root.is_editing_path && !root.is_renaming {
                root.key_shortcut("up");
                return accept;
            }
            if event.text == Key.DownArrow && !root.is_editing_path && !root.is_renaming {
                root.key_shortcut("down");
                return accept;
            }
            if event.text == Key.Escape {
                if root.active_flyout != "" {
                    root.active_flyout = "";
                    root.show_sub_flyout = false;
                } else if root.is_editing_path {
                    root.is_editing_path = false;
                } else if root.is_renaming {
                    root.is_renaming = false;
                } else if root.search_text != "" {
                    root.search_text = "";
                    root.search_changed("");
                }
                return accept;
            }
            return reject;
        }

        // Outer Window Frame
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.content_bg;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 1px;
                spacing: 0px;

                // =========================================================
                // 1. UNIFIED WINDOWS 11 TITLEBAR & TAB STRIP (NO TOP BORDER)
                // =========================================================
                Rectangle {
                    height: 38px;
                    background: Theme.titlebar_bg;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 0px;
                        padding-top: 0px;
                        padding-bottom: 0px;
                        spacing: 0px;

                        // Tabs Area (aligned to bottom of the 38px titlebar so active tab blends into row 2)
                        HorizontalLayout {
                            padding-top: 6px;
                            spacing: 2px;

                            for tab[idx] in root.tabs: Rectangle {
                                width: 195px;
                                height: 32px;
                                border-top-left-radius: 7px;
                                border-top-right-radius: 7px;
                                background: tab.is_active ? Theme.nav_bg : (tab_touch.has-hover ? Theme.hover_bg : transparent);

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                    spacing: 8px;

                                    FluentEntryIcon {
                                        y: (parent.height - self.height) / 2;
                                        is_dir: true;
                                        icon_px: 15;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: tab.title;
                                        font-size: 12px;
                                        font-weight: tab.is_active ? 600 : 400;
                                        color: tab.is_active ? Theme.text_primary : Theme.text_secondary;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }

                                    // Tab Close Button
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        background: close_touch.has-hover ? Theme.hover_bg : transparent;

                                        Text {
                                            text: "\u{E8BB}";
                                            font-family: "Segoe Fluent Icons";
                                            font-size: 8.5px;
                                            color: close_touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        close_touch := TouchArea {
                                            clicked => { root.tab_closed(idx); }
                                        }
                                    }
                                }

                                tab_touch := TouchArea {
                                    width: parent.width - 28px;
                                    height: parent.height;
                                    clicked => { root.tab_selected(idx); }
                                }
                            }

                            // New Tab (+) Button next to tabs
                            Rectangle {
                                width: 28px;
                                height: 26px;
                                y: 3px;
                                border-radius: 4px;
                                background: new_tab_touch.has-hover ? Theme.hover_bg : transparent;

                                Text {
                                    text: "\u{E710}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 11px;
                                    color: Theme.text_primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                new_tab_touch := TouchArea {
                                    clicked => { root.tab_new(); }
                                }
                            }
                        }

                        // Draggable Titlebar Region
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 38px;
                            background: transparent;

                            TouchArea {
                                double-clicked => { root.window_maximize(); }
                                pointer-event(pe) => {
                                    if pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down {
                                        root.window_drag();
                                    }
                                }
                            }
                        }

                        // Top-Right Windows 11 Caption Controls (Minimize, Maximize, Close)
                        HorizontalLayout {
                            spacing: 0px;
                            padding-bottom: 6px;

                            CaptionButton {
                                icon: "\u{E921}";
                                clicked => { root.window_minimize(); }
                            }

                            CaptionButton {
                                icon: "\u{E922}";
                                clicked => { root.window_maximize(); }
                            }

                            CaptionButton {
                                icon: "\u{E8BB}";
                                is_close: true;
                                clicked => { root.window_close(); }
                            }
                        }
                    }
                }

                // =========================================================
                // 2. NAVIGATION & BREADCRUMB ADDRESS BAR ROW (SINGLE CLEAN BORDER)
                // =========================================================
                Rectangle {
                    height: 44px;
                    background: Theme.nav_bg;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        FluentIconButton {
                            icon: "\u{E72B}";
                            is_disabled: !root.can_go_back;
                            clicked => { root.nav_back(); }
                        }

                        FluentIconButton {
                            icon: "\u{E72A}";
                            is_disabled: !root.can_go_forward;
                            clicked => { root.nav_forward(); }
                        }

                        FluentIconButton {
                            icon: "\u{E74A}";
                            clicked => { root.nav_up(); }
                        }

                        FluentIconButton {
                            icon: "\u{E72C}";
                            clicked => { root.nav_refresh(); }
                        }

                        // Single-Border Windows 11 Breadcrumb / Address Bar (Zero double-border glitch)
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 32px;
                            border-radius: 4px;
                            background: Theme.input_bg;
                            border-width: 1px;
                            border-color: (root.is_editing_path || addr_input.has-focus) ? Theme.accent : Theme.border;

                            // Breadcrumb mode
                            if !root.is_editing_path: HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 2px;

                                Text {
                                    width: 18px;
                                    text: root.active_nav_key == "network" ? "\u{E774}" : (root.active_nav_key == "home" ? "\u{E80F}" : "\u{EC4E}");
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 13px;
                                    color: Theme.text_secondary;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    width: 12px;
                                    text: "\u{E76C}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 8px;
                                    color: Theme.text_muted;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }

                                for crumb[c_idx] in root.crumbs: HorizontalLayout {
                                    spacing: 1px;

                                    Rectangle {
                                        height: 24px;
                                        y: 3px;
                                        border-radius: 3px;
                                        background: crumb_touch.has-hover ? Theme.hover_bg : transparent;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;

                                            Text {
                                                text: crumb.label;
                                                font-size: 12px;
                                                font-weight: 400;
                                                color: Theme.text_primary;
                                                vertical-alignment: center;
                                            }
                                        }

                                        crumb_touch := TouchArea {
                                            clicked => { root.nav_to_path(crumb.path); }
                                        }
                                    }

                                    if c_idx < root.crumbs.length - 1: Text {
                                        width: 12px;
                                        text: "\u{E76C}";
                                        font-family: "Segoe Fluent Icons";
                                        font-size: 8px;
                                        color: Theme.text_muted;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                // Click trailing space to switch to raw path TextInput
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                    TouchArea {
                                        clicked => {
                                            root.raw_path_text = root.current_path;
                                            root.is_editing_path = true;
                                            addr_input.focus();
                                        }
                                    }
                                }
                            }

                            // Raw Path Edit mode using borderless TextInput (No nested box!)
                            HorizontalLayout {
                                visible: root.is_editing_path;
                                padding-left: 10px;
                                padding-right: 4px;
                                spacing: 4px;

                                addr_input := TextInput {
                                    horizontal-stretch: 1;
                                    font-size: 12px;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                    single-line: true;
                                    text <=> root.raw_path_text;
                                    accepted => {
                                        root.is_editing_path = false;
                                        root.nav_to_path(self.text);
                                        key_scope.focus();
                                    }
                                }

                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: cancel_path_touch.has-hover ? Theme.hover_bg : transparent;

                                    Text {
                                        text: "\u{E8BB}";
                                        font-family: "Segoe Fluent Icons";
                                        font-size: 9px;
                                        color: Theme.text_secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    cancel_path_touch := TouchArea {
                                        clicked => {
                                            root.is_editing_path = false;
                                            key_scope.focus();
                                        }
                                    }
                                }
                            }
                        }

                        // Single-Border Windows 11 Search Box (Borderless TextInput + Aligned Clear & Search Icons)
                        Rectangle {
                            width: 240px;
                            height: 32px;
                            border-radius: 4px;
                            background: Theme.input_bg;
                            border-width: 1px;
                            border-color: search_input.has-focus ? Theme.accent : Theme.border;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 6px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    // Placeholder text when empty
                                    if root.search_text == "": Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "Search " + root.current_folder_name;
                                        font-size: 12px;
                                        color: Theme.text_muted;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }

                                    search_input := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        font-size: 12px;
                                        color: Theme.text_primary;
                                        vertical-alignment: center;
                                        single-line: true;
                                        text <=> root.search_text;
                                        edited => {
                                            root.search_changed(self.text);
                                        }
                                        accepted => {
                                            root.search_changed(self.text);
                                        }
                                    }
                                }

                                if root.search_text != "": Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: clear_search_touch.has-hover ? Theme.hover_bg : transparent;

                                    Text {
                                        text: "\u{E8BB}";
                                        font-family: "Segoe Fluent Icons";
                                        font-size: 8.5px;
                                        color: Theme.text_secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    clear_search_touch := TouchArea {
                                        clicked => {
                                            root.search_text = "";
                                            root.search_changed("");
                                            key_scope.focus();
                                        }
                                    }
                                }

                                Text {
                                    width: 16px;
                                    text: "\u{E721}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 12px;
                                    color: Theme.text_secondary;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Subtle separator between Navigation Row and Command Bar
                Rectangle { height: 1px; background: Theme.divider; }

                // =========================================================
                // 3. WINDOWS 11 COMMAND BAR
                // =========================================================
                Rectangle {
                    height: 42px;
                    background: Theme.cmd_bg;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 3px;

                        CommandBarButton {
                            icon: "\u{E710}";
                            icon_tint: Theme.accent;
                            label: "New";
                            has_dropdown: true;
                            is_active: root.active_flyout == "new";
                            clicked => {
                                root.show_sub_flyout = false;
                                root.active_flyout = root.active_flyout == "new" ? "" : "new";
                            }
                        }

                        Rectangle {
                            width: 1px;
                            height: 20px;
                            y: 6px;
                            background: Theme.divider;
                        }

                        CommandBarButton {
                            icon: "\u{E8C6}";
                            is_disabled: root.selected_index < 0;
                            clicked => { root.command_cut(); }
                        }

                        CommandBarButton {
                            icon: "\u{E8C8}";
                            is_disabled: root.selected_index < 0;
                            clicked => { root.command_copy(); }
                        }

                        CommandBarButton {
                            icon: "\u{E77F}";
                            clicked => { root.command_paste(); }
                        }

                        CommandBarButton {
                            icon: "\u{E8AC}";
                            is_disabled: root.selected_index < 0;
                            clicked => { root.command_rename(); }
                        }

                        CommandBarButton {
                            icon: "\u{E8AC}";
                            is_disabled: true;
                            visible: false;
                        }

                        CommandBarButton {
                            icon: "\u{E72D}";
                            is_disabled: root.selected_index < 0;
                            clicked => { root.item_right_clicked(root.selected_index); }
                        }

                        CommandBarButton {
                            icon: "\u{E74D}";
                            is_disabled: root.selected_index < 0;
                            clicked => { root.command_delete(); }
                        }

                        Rectangle {
                            width: 1px;
                            height: 20px;
                            y: 6px;
                            background: Theme.divider;
                        }

                        CommandBarButton {
                            icon: "\u{E8CB}";
                            icon_tint: Theme.accent;
                            label: "Sort";
                            has_dropdown: true;
                            is_active: root.active_flyout == "sort";
                            clicked => {
                                root.show_sub_flyout = false;
                                root.active_flyout = root.active_flyout == "sort" ? "" : "sort";
                            }
                        }

                        CommandBarButton {
                            icon: root.view_mode == "details" ? "\u{E8FD}" : "\u{E8A9}";
                            label: "View";
                            has_dropdown: true;
                            is_active: root.active_flyout == "view";
                            clicked => {
                                root.show_sub_flyout = false;
                                root.active_flyout = root.active_flyout == "view" ? "" : "view";
                            }
                        }

                        if root.active_nav_key == "network": CommandBarButton {
                            icon: "\u{E774}";
                            icon_tint: Theme.accent;
                            label: "Map network drive";
                            clicked => { root.command_map_network_drive(); }
                        }

                        // Flexible middle spacer pushing Details/Preview to the right
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        CommandBarButton {
                            icon: "\u{E946}";
                            icon_tint: root.show_details ? Theme.accent : Theme.text_primary;
                            label: "Details";
                            is_active: root.show_details;
                            clicked => { root.command_toggle_details(); }
                        }

                        CommandBarButton {
                            icon: "\u{E890}";
                            icon_tint: root.show_preview ? Theme.accent : Theme.text_primary;
                            label: "Preview";
                            is_active: root.show_preview;
                            clicked => { root.command_toggle_preview(); }
                        }
                    }
                }

                // Separator below Command Bar
                Rectangle { height: 1px; background: Theme.divider; }

                // =========================================================
                // 4. MAIN WORKSPACE (Resizable Sidebar + Folder View + Resizable Pane)
                // =========================================================
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;

                    // Left Navigation Sidebar
                    if root.show_nav_pane: Rectangle {
                        width: root.sidebar_width;
                        background: Theme.sidebar_bg;

                        ScrollView {
                            VerticalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                padding-top: 6px;
                                padding-bottom: 10px;
                                spacing: root.compact_view ? 0px : 2px;

                                NavItem {
                                    icon: "\u{E80F}";
                                    icon_color: #60cdff;
                                    label: "Home";
                                    compact: root.compact_view;
                                    is_selected: root.active_nav_key == "home";
                                    clicked => { root.nav_to_path("home"); }
                                }

                                NavItem {
                                    icon: "\u{EB9F}";
                                    icon_color: #c58af9;
                                    label: "Gallery";
                                    compact: root.compact_view;
                                    is_selected: root.active_nav_key == "gallery";
                                    clicked => { root.nav_to_path("pictures"); }
                                }

                                Rectangle {
                                    height: 9px;
                                    Rectangle {
                                        x: 8px;
                                        y: 4px;
                                        width: parent.width - 16px;
                                        height: 1px;
                                        background: Theme.divider;
                                    }
                                }

                                NavItem {
                                    icon: "\u{E8FC}";
                                    icon_color: #4cc2ff;
                                    label: "Desktop";
                                    compact: root.compact_view;
                                    has_chevron: true;
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "desktop";
                                    clicked => { root.nav_to_path("desktop"); }
                                }

                                NavItem {
                                    icon: "\u{E896}";
                                    icon_color: #28c76f;
                                    label: "Downloads";
                                    compact: root.compact_view;
                                    has_chevron: true;
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "downloads";
                                    clicked => { root.nav_to_path("downloads"); }
                                }

                                NavItem {
                                    icon: "\u{E8A5}";
                                    icon_color: #a6b4c0;
                                    label: "Documents";
                                    compact: root.compact_view;
                                    has_chevron: true;
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "documents";
                                    clicked => { root.nav_to_path("documents"); }
                                }

                                NavItem {
                                    icon: "\u{EB9F}";
                                    icon_color: #ff9f43;
                                    label: "Pictures";
                                    compact: root.compact_view;
                                    has_chevron: true;
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "pictures";
                                    clicked => { root.nav_to_path("pictures"); }
                                }

                                NavItem {
                                    icon: "\u{E8D6}";
                                    icon_color: #ff6b8b;
                                    label: "Music";
                                    compact: root.compact_view;
                                    has_chevron: true;
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "music";
                                    clicked => { root.nav_to_path("music"); }
                                }

                                NavItem {
                                    icon: "\u{E8B2}";
                                    icon_color: #00cfe8;
                                    label: "Videos";
                                    compact: root.compact_view;
                                    has_chevron: true;
                                    is_pinned: true;
                                    is_selected: root.active_nav_key == "videos";
                                    clicked => { root.nav_to_path("videos"); }
                                }

                                Rectangle {
                                    height: 9px;
                                    Rectangle {
                                        x: 8px;
                                        y: 4px;
                                        width: parent.width - 16px;
                                        height: 1px;
                                        background: Theme.divider;
                                    }
                                }

                                // This PC (Clickable Dashboard matching Windows 11)
                                NavItem {
                                    icon: "\u{EC4E}";
                                    icon_color: #60cdff;
                                    label: "This PC";
                                    compact: root.compact_view;
                                    has_chevron: true;
                                    is_selected: root.active_nav_key == "this_pc";
                                    clicked => { root.nav_to_path("this_pc"); }
                                }

                                for drive in root.drives: NavItem {
                                    icon: drive.is_cloud ? "\u{E753}" : "\u{EDA2}";
                                    icon_color: drive.is_cloud ? #4cc2ff : #a0b0c0;
                                    label: drive.name;
                                    compact: root.compact_view;
                                    has_chevron: true;
                                    is_selected: root.current_path == drive.letter;
                                    clicked => { root.nav_to_path(drive.letter); }
                                }

                                // Network / NAS Section
                                NavItem {
                                    icon: "\u{E774}";
                                    icon_color: #60cdff;
                                    label: "Network";
                                    compact: root.compact_view;
                                    has_chevron: true;
                                    is_selected: root.active_nav_key == "network";
                                    clicked => { root.nav_to_path("network"); }
                                }
                            }
                        }
                    }

                    // Draggable Splitter between Left Sidebar and Center Content
                    if root.show_nav_pane: Rectangle {
                        width: 5px;
                        background: sidebar_split_touch.has-hover || sidebar_split_touch.pressed ? Theme.accent : transparent;

                        Rectangle {
                            x: 2px;
                            width: 1px;
                            height: 100%;
                            background: Theme.divider;
                        }

                        sidebar_split_touch := TouchArea {
                            mouse-cursor: ew-resize;
                            moved => {
                                if self.pressed {
                                    root.sidebar_width = Math.clamp(root.sidebar_width + (self.mouse-x - self.pressed-x), 150px, 420px);
                                }
                            }
                        }
                    }

                    // =========================================================
                    // CENTER CONTENT VIEW ("This PC" Dashboard, Details Table, or Multi-Column Grid)
                    // =========================================================
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.content_bg;

                        VerticalLayout {
                            spacing: 0px;

                            // ---------------------------------------------------------
                            // A. "THIS PC" DEVICES AND DRIVES VIEW
                            // ---------------------------------------------------------
                            if root.active_nav_key == "this_pc": ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 14px;

                                    HorizontalLayout {
                                        height: 24px;
                                        spacing: 8px;

                                        Text {
                                            text: "\u{E70D}";
                                            font-family: "Segoe Fluent Icons";
                                            font-size: 10px;
                                            color: Theme.text_secondary;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "Devices and drives (" + root.drives.length + ")";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: Theme.text_primary;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 1px;
                                            y: 12px;
                                            background: Theme.divider;
                                        }
                                    }

                                    // Responsive Drive Tiles
                                    HorizontalLayout {
                                        spacing: 16px;
                                        alignment: start;

                                        for drive in root.drives: Rectangle {
                                            width: 265px;
                                            height: 76px;
                                            border-radius: 6px;
                                            background: pc_drive_touch.has-hover ? Theme.row_hover : Theme.pane_bg;
                                            border-width: 1px;
                                            border-color: pc_drive_touch.has-hover ? Theme.border : Theme.divider;

                                            HorizontalLayout {
                                                padding: 12px;
                                                spacing: 12px;

                                                Rectangle {
                                                    width: 44px;
                                                    height: 44px;
                                                    y: (parent.height - self.height) / 2;
                                                    background: transparent;

                                                    Text {
                                                        text: drive.is_cloud ? "\u{E753}" : "\u{EDA2}";
                                                        font-family: "Segoe Fluent Icons";
                                                        font-size: 34px;
                                                        color: Theme.accent;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 5px;

                                                    Text {
                                                        text: drive.name;
                                                        font-size: 12.5px;
                                                        font-weight: 600;
                                                        color: Theme.text_primary;
                                                        horizontal-alignment: left;
                                                        overflow: elide;
                                                    }

                                                    Rectangle {
                                                        height: 10px;
                                                        border-radius: 2px;
                                                        background: Theme.border;

                                                        Rectangle {
                                                            x: 0px;
                                                            width: parent.width * drive.percent_used;
                                                            height: parent.height;
                                                            border-radius: 2px;
                                                            background: drive.percent_used > 0.9 ? #f85149 : #2088d8;
                                                        }
                                                    }

                                                    Text {
                                                        text: drive.free_str + " free of " + drive.total_str;
                                                        font-size: 11.5px;
                                                        color: Theme.text_secondary;
                                                        horizontal-alignment: left;
                                                        overflow: elide;
                                                    }
                                                }
                                            }

                                            pc_drive_touch := TouchArea {
                                                clicked => { root.nav_to_path(drive.letter); }
                                            }
                                        }
                                    }
                                }
                            }

                            // ---------------------------------------------------------
                            // B. DETAILS TABLE HEADER (WITH DRAGGABLE COLUMN RESIZERS)
                            // ---------------------------------------------------------
                            if root.active_nav_key != "this_pc" && root.view_mode == "details": Rectangle {
                                height: 30px;
                                background: Theme.content_bg;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 0px;

                                    // 1. Name Header (Resizable!)
                                    Rectangle {
                                        width: root.col_name_width;
                                        background: name_hdr_touch.has-hover ? Theme.row_hover : transparent;
                                        border-radius: 3px;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 6px;
                                            spacing: 6px;

                                            Text {
                                                text: "Name";
                                                font-size: 12px;
                                                font-weight: 400;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                            }

                                            if root.sort_column == "name": Text {
                                                text: root.sort_asc ? "\u{E70E}" : "\u{E70D}";
                                                font-family: "Segoe Fluent Icons";
                                                font-size: 8px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        name_hdr_touch := TouchArea {
                                            clicked => { root.sort_by("name"); }
                                        }
                                    }

                                    // Draggable Resizer Handle for Name Column
                                    Rectangle {
                                        width: 7px;
                                        background: name_resizer.has-hover || name_resizer.pressed ? Theme.accent : transparent;
                                        Rectangle {
                                            x: 3px;
                                            y: 7px;
                                            width: 1px;
                                            height: 16px;
                                            background: Theme.divider;
                                        }
                                        name_resizer := TouchArea {
                                            mouse-cursor: ew-resize;
                                            moved => {
                                                if self.pressed {
                                                    root.col_name_width = Math.clamp(root.col_name_width + (self.mouse-x - self.pressed-x), 110px, 750px);
                                                }
                                            }
                                        }
                                    }

                                    // 2. Date modified Header (Resizable!)
                                    Rectangle {
                                        width: root.col_date_width;
                                        background: date_hdr_touch.has-hover ? Theme.row_hover : transparent;
                                        border-radius: 3px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            spacing: 6px;

                                            Text {
                                                text: "Date modified";
                                                font-size: 12px;
                                                font-weight: 400;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                            }

                                            if root.sort_column == "date": Text {
                                                text: root.sort_asc ? "\u{E70E}" : "\u{E70D}";
                                                font-family: "Segoe Fluent Icons";
                                                font-size: 8px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        date_hdr_touch := TouchArea {
                                            clicked => { root.sort_by("date"); }
                                        }
                                    }

                                    // Draggable Resizer Handle for Date Column
                                    Rectangle {
                                        width: 7px;
                                        background: date_resizer.has-hover || date_resizer.pressed ? Theme.accent : transparent;
                                        Rectangle {
                                            x: 3px;
                                            y: 7px;
                                            width: 1px;
                                            height: 16px;
                                            background: Theme.divider;
                                        }
                                        date_resizer := TouchArea {
                                            mouse-cursor: ew-resize;
                                            moved => {
                                                if self.pressed {
                                                    root.col_date_width = Math.clamp(root.col_date_width + (self.mouse-x - self.pressed-x), 90px, 400px);
                                                }
                                            }
                                        }
                                    }

                                    // 3. Type Header (Resizable!)
                                    Rectangle {
                                        width: root.col_type_width;
                                        background: type_hdr_touch.has-hover ? Theme.row_hover : transparent;
                                        border-radius: 3px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            spacing: 6px;

                                            Text {
                                                text: "Type";
                                                font-size: 12px;
                                                font-weight: 400;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                            }

                                            if root.sort_column == "type": Text {
                                                text: root.sort_asc ? "\u{E70E}" : "\u{E70D}";
                                                font-family: "Segoe Fluent Icons";
                                                font-size: 8px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        type_hdr_touch := TouchArea {
                                            clicked => { root.sort_by("type"); }
                                        }
                                    }

                                    // Draggable Resizer Handle for Type Column
                                    Rectangle {
                                        width: 7px;
                                        background: type_resizer.has-hover || type_resizer.pressed ? Theme.accent : transparent;
                                        Rectangle {
                                            x: 3px;
                                            y: 7px;
                                            width: 1px;
                                            height: 16px;
                                            background: Theme.divider;
                                        }
                                        type_resizer := TouchArea {
                                            mouse-cursor: ew-resize;
                                            moved => {
                                                if self.pressed {
                                                    root.col_type_width = Math.clamp(root.col_type_width + (self.mouse-x - self.pressed-x), 80px, 420px);
                                                }
                                            }
                                        }
                                    }

                                    // 4. Size Header (Resizable!)
                                    Rectangle {
                                        width: root.col_size_width;
                                        background: size_hdr_touch.has-hover ? Theme.row_hover : transparent;
                                        border-radius: 3px;

                                        HorizontalLayout {
                                            padding-right: 6px;
                                            spacing: 6px;

                                            Rectangle { horizontal-stretch: 1; }

                                            if root.sort_column == "size": Text {
                                                text: root.sort_asc ? "\u{E70E}" : "\u{E70D}";
                                                font-family: "Segoe Fluent Icons";
                                                font-size: 8px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: "Size";
                                                font-size: 12px;
                                                font-weight: 400;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: right;
                                            }
                                        }

                                        size_hdr_touch := TouchArea {
                                            clicked => { root.sort_by("size"); }
                                        }
                                    }

                                    Rectangle {
                                        width: 7px;
                                        background: size_resizer.has-hover || size_resizer.pressed ? Theme.accent : transparent;
                                        Rectangle {
                                            x: 3px;
                                            y: 7px;
                                            width: 1px;
                                            height: 16px;
                                            background: Theme.divider;
                                        }
                                        size_resizer := TouchArea {
                                            mouse-cursor: ew-resize;
                                            moved => {
                                                if self.pressed {
                                                    root.col_size_width = Math.clamp(root.col_size_width + (self.mouse-x - self.pressed-x), 60px, 260px);
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }

                            // ---------------------------------------------------------
                            // C. DETAILS TABLE ROWS (Windows 11 Compact 24px / Normal 30px)
                            // ---------------------------------------------------------
                            if root.active_nav_key != "this_pc" && root.view_mode == "details": ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 2px;
                                    padding-bottom: 8px;
                                    spacing: root.compact_view ? 0px : 1px;

                                    if root.entries.length == 0: Rectangle {
                                        height: 120px;
                                        Text {
                                            text: root.search_text != "" ? "No items match your search." : (root.active_nav_key == "network" ? "No connected network shares found. Click 'Map network drive' or type \\\\server\\share in the address bar." : "This folder is empty.");
                                            font-size: 12.5px;
                                            color: Theme.text_secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    for entry[e_idx] in root.entries: Rectangle {
                                        property <bool> drag_triggered: false;

                                        height: root.compact_view ? 24px : 30px;
                                        border-radius: 3px;
                                        background: root.selected_index == e_idx ? Theme.row_selected : (row_touch.has-hover ? Theme.row_hover : transparent);

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 0px;

                                            // Name Column (Matches col_name_width)
                                            HorizontalLayout {
                                                width: root.col_name_width - 6px;
                                                spacing: 8px;

                                                if root.item_check_boxes: Rectangle {
                                                    width: 14px;
                                                    height: 14px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 3px;
                                                    border-width: 1px;
                                                    border-color: root.selected_index == e_idx ? Theme.accent : Theme.border;
                                                    background: root.selected_index == e_idx ? Theme.accent : transparent;
                                                }

                                                FluentEntryIcon {
                                                    y: (parent.height - self.height) / 2;
                                                    is_dir: entry.is_dir;
                                                    glyph: entry.icon_glyph;
                                                    glyph_color: entry.icon_color;
                                                    has_thumb: entry.has_thumb;
                                                    thumb: entry.thumb;
                                                    is_cloud: entry.is_cloud;
                                                    icon_px: 16;
                                                }

                                                if !(root.is_renaming && root.selected_index == e_idx): Text {
                                                    horizontal-stretch: 1;
                                                    text: entry.name;
                                                    font-size: 12px;
                                                    font-weight: 400;
                                                    color: Theme.text_primary;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }

                                                if root.is_renaming && root.selected_index == e_idx: Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 20px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 3px;
                                                    background: Theme.input_bg;
                                                    border-width: 1px;
                                                    border-color: Theme.accent;

                                                    HorizontalLayout {
                                                        padding-left: 4px;
                                                        padding-right: 4px;

                                                        TextInput {
                                                            horizontal-stretch: 1;
                                                            font-size: 12px;
                                                            color: Theme.text_primary;
                                                            vertical-alignment: center;
                                                            single-line: true;
                                                            text <=> root.rename_text;
                                                            accepted => {
                                                                root.is_renaming = false;
                                                                root.command_commit_rename(self.text);
                                                                key_scope.focus();
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Spacer matching Name resizer
                                            Rectangle { width: 7px; }

                                            // Date modified Column (Matches col_date_width)
                                            Text {
                                                width: root.col_date_width;
                                                text: entry.mtime_str;
                                                font-size: 12px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                            }

                                            Rectangle { width: 7px; }

                                            // Type Column (Matches col_type_width)
                                            Text {
                                                width: root.col_type_width;
                                                text: entry.type_str;
                                                font-size: 12px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                            }

                                            Rectangle { width: 7px; }

                                            // Size Column (Matches col_size_width)
                                            Text {
                                                width: root.col_size_width;
                                                text: entry.size_str;
                                                font-size: 12px;
                                                color: Theme.text_secondary;
                                                vertical-alignment: center;
                                                horizontal-alignment: right;
                                                overflow: elide;
                                            }

                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        row_touch := TouchArea {
                                            enabled: !(root.is_renaming && root.selected_index == e_idx);
                                            clicked => {
                                                key_scope.focus();
                                                root.item_clicked(e_idx);
                                            }
                                            double-clicked => {
                                                root.item_double_clicked(e_idx);
                                            }
                                            pointer-event(pe) => {
                                                if pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down {
                                                    parent.drag_triggered = false;
                                                }
                                                if pe.button == PointerEventButton.right && pe.kind == PointerEventKind.down {
                                                    root.item_clicked(e_idx);
                                                    root.item_right_clicked(e_idx);
                                                }
                                            }
                                            moved => {
                                                if self.pressed && !parent.drag_triggered {
                                                    if Math.abs(self.mouse-x - self.pressed-x) > 6px || Math.abs(self.mouse-y - self.pressed-y) > 6px {
                                                        parent.drag_triggered = true;
                                                        root.item_drag_started(e_idx);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ---------------------------------------------------------
                            // D. MULTI-COLUMN GRID VIEWS (Tiles, Extra Large, Large, Medium, Small, List, Content)
                            // ---------------------------------------------------------
                            if root.active_nav_key != "this_pc" && root.view_mode != "details": ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: root.view_mode == "list" || root.view_mode == "small_icons" ? 2px : 8px;

                                    for grow in root.grid_rows: HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        for item in grow.items: Rectangle {
                                            property <bool> drag_triggered: false;
                                            property <bool> is_vertical_card: root.view_mode == "xl_icons" || root.view_mode == "large_icons" || root.view_mode == "icons";

                                            width: root.view_mode == "content" ? 680px : (root.view_mode == "tiles" ? 255px : (root.view_mode == "xl_icons" ? 160px : (root.view_mode == "large_icons" ? 124px : (root.view_mode == "icons" ? 104px : 210px))));
                                            height: root.view_mode == "xl_icons" ? 142px : (root.view_mode == "large_icons" ? 112px : (root.view_mode == "icons" ? 92px : (root.view_mode == "tiles" || root.view_mode == "content" ? 58px : 26px)));
                                            border-radius: 3px;
                                            background: root.selected_index == item.orig_index ? Theme.row_selected : (card_touch.has-hover ? Theme.row_hover : transparent);
                                            border-width: root.selected_index == item.orig_index ? 1px : 0px;
                                            border-color: root.selected_index == item.orig_index ? #ffffffa0 : transparent;

                                            // Vertical Icon Card (Extra large, Large, Medium-sized icons)
                                            if self.is_vertical_card: VerticalLayout {
                                                padding: 6px;
                                                spacing: 4px;

                                                Rectangle {
                                                    vertical-stretch: 1;
                                                    background: transparent;

                                                    FluentEntryIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        is_dir: item.is_dir;
                                                        glyph: item.icon_glyph;
                                                        glyph_color: item.icon_color;
                                                        has_thumb: item.has_thumb;
                                                        thumb: item.thumb;
                                                        is_cloud: item.is_cloud;
                                                        icon_px: root.view_mode == "xl_icons" ? 84 : (root.view_mode == "large_icons" ? 58 : 42);
                                                    }
                                                }

                                                Text {
                                                    height: 30px;
                                                    text: item.name;
                                                    font-size: 12px;
                                                    color: Theme.text_primary;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: top;
                                                    wrap: word-wrap;
                                                    overflow: elide;
                                                }
                                            }

                                            // Horizontal Tile / Small Icons / List / Content Card (Exact replica of Screenshot 2)
                                            if !self.is_vertical_card: HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 8px;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                spacing: 8px;

                                                FluentEntryIcon {
                                                    y: (parent.height - self.height) / 2;
                                                    is_dir: item.is_dir;
                                                    glyph: item.icon_glyph;
                                                    glyph_color: item.icon_color;
                                                    has_thumb: item.has_thumb;
                                                    thumb: item.thumb;
                                                    is_cloud: item.is_cloud;
                                                    icon_px: (root.view_mode == "tiles" || root.view_mode == "content") ? 42 : 16;
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 1px;

                                                    Text {
                                                        text: item.name;
                                                        font-size: 12px;
                                                        color: Theme.text_primary;
                                                        horizontal-alignment: left;
                                                        overflow: elide;
                                                    }

                                                    if root.view_mode == "tiles" || root.view_mode == "content": Text {
                                                        text: item.type_str;
                                                        font-size: 11.5px;
                                                        color: Theme.text_secondary;
                                                        horizontal-alignment: left;
                                                        overflow: elide;
                                                    }

                                                    if (root.view_mode == "tiles" || root.view_mode == "content") && item.size_str != "": Text {
                                                        text: item.size_str + (root.view_mode == "content" && item.mtime_str != "" ? "  •  Date modified: " + item.mtime_str : "");
                                                        font-size: 11.5px;
                                                        color: Theme.text_secondary;
                                                        horizontal-alignment: left;
                                                        overflow: elide;
                                                    }
                                                }
                                            }

                                            card_touch := TouchArea {
                                                clicked => {
                                                    key_scope.focus();
                                                    root.item_clicked(item.orig_index);
                                                }
                                                double-clicked => {
                                                    root.item_double_clicked(item.orig_index);
                                                }
                                                pointer-event(pe) => {
                                                    if pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down {
                                                        parent.drag_triggered = false;
                                                    }
                                                    if pe.button == PointerEventButton.right && pe.kind == PointerEventKind.down {
                                                        root.item_clicked(item.orig_index);
                                                        root.item_right_clicked(item.orig_index);
                                                    }
                                                }
                                                moved => {
                                                    if self.pressed && !parent.drag_triggered {
                                                        if Math.abs(self.mouse-x - self.pressed-x) > 6px || Math.abs(self.mouse-y - self.pressed-y) > 6px {
                                                            parent.drag_triggered = true;
                                                            root.item_drag_started(item.orig_index);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Draggable Splitter before Right Preview/Details Pane
                    if root.show_preview || root.show_details: Rectangle {
                        width: 5px;
                        background: pane_split_touch.has-hover || pane_split_touch.pressed ? Theme.accent : transparent;

                        Rectangle {
                            x: 2px;
                            width: 1px;
                            height: 100%;
                            background: Theme.divider;
                        }

                        pane_split_touch := TouchArea {
                            mouse-cursor: ew-resize;
                            moved => {
                                if self.pressed {
                                    root.pane_width = Math.clamp(root.pane_width - (self.mouse-x - self.pressed-x), 230px, 560px);
                                }
                            }
                        }
                    }

                    // =========================================================
                    // RIGHT PREVIEW PANE (Real WinRT PDF Page + Text, Images, Excel, Word, Code)
                    // =========================================================
                    if root.show_preview: Rectangle {
                        width: root.pane_width;
                        background: Theme.pane_bg;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;

                                Text {
                                    width: 20px;
                                    text: "\u{E890}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 14px;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;

                                    Text {
                                        text: root.preview_title != "" ? root.preview_title : "Preview";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: Theme.text_primary;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.preview_subtitle;
                                        font-size: 11.5px;
                                        color: Theme.text_secondary;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }
                                }

                                FluentIconButton {
                                    icon: "\u{E8BB}";
                                    clicked => { root.command_toggle_preview(); }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.divider; }

                            // High-Resolution Visual PDF Page Render or Image Preview
                            if root.has_preview_image: Rectangle {
                                height: root.preview_type == "image" ? 280px : 240px;
                                border-radius: 5px;
                                background: Theme.content_bg;
                                border-width: 1px;
                                border-color: Theme.border;

                                Image {
                                    width: parent.width - 10px;
                                    height: parent.height - 10px;
                                    x: 5px;
                                    y: 5px;
                                    source: root.preview_image;
                                    image-fit: contain;
                                }
                            }

                            // Spreadsheet / Table Preview (Excel & CSV)
                            if root.preview_type == "table": ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 1px;

                                    Rectangle {
                                        height: 24px;
                                        background: Theme.nav_bg;
                                        border-radius: 3px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            for h in root.preview_table_headers: Text {
                                                width: 85px;
                                                text: h;
                                                font-size: 11.5px;
                                                font-weight: 600;
                                                color: Theme.accent;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    for row in root.preview_table_rows: Rectangle {
                                        height: 22px;
                                        background: Theme.content_bg;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            for cell in row.cells: Text {
                                                width: 85px;
                                                text: cell;
                                                font-size: 11.5px;
                                                color: Theme.text_primary;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }

                            // PDF Text / Word / PowerPoint / Code / Markdown Preview
                            if root.preview_type == "text" || root.preview_type == "image": ScrollView {
                                vertical-stretch: 1;
                                Text {
                                    text: root.preview_text_content;
                                    font-family: "Segoe UI Variable Text";
                                    font-size: 12px;
                                    color: Theme.text_primary;
                                    wrap: word-wrap;
                                }
                            }

                            if root.preview_type == "none": Rectangle {
                                vertical-stretch: 1;
                                Text {
                                    text: "Select a file to preview";
                                    font-size: 12px;
                                    color: Theme.text_secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // =========================================================
                    // RIGHT DETAILS PANE (Exact replica of Screenshot 5)
                    // =========================================================
                    if root.show_details: Rectangle {
                        width: root.pane_width;
                        background: Theme.pane_bg;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;

                                FluentEntryIcon {
                                    y: (parent.height - self.height) / 2;
                                    is_dir: root.selected_index < 0;
                                    icon_px: 18;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.selected_index >= 0 ? root.preview_title : (root.current_folder_name + " (" + root.status_item_count + ")");
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                    overflow: elide;
                                }

                                FluentIconButton {
                                    icon: "\u{E8BB}";
                                    clicked => { root.command_toggle_details(); }
                                }
                            }

                            if root.selected_index >= 0 && root.has_preview_image: Rectangle {
                                height: 140px;
                                border-radius: 5px;
                                background: Theme.content_bg;
                                border-width: 1px;
                                border-color: Theme.border;

                                Image {
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    x: 4px;
                                    y: 4px;
                                    source: root.preview_image;
                                    image-fit: contain;
                                }
                            }

                            Rectangle { height: 1px; background: Theme.divider; }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 8px;

                                    if root.item_properties.length == 0: Text {
                                        text: "Select an item to view its properties.";
                                        font-size: 12px;
                                        color: Theme.text_secondary;
                                        wrap: word-wrap;
                                    }

                                    for prop in root.item_properties: VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: prop.name;
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            color: Theme.text_secondary;
                                            horizontal-alignment: left;
                                        }
                                        Text {
                                            text: prop.value;
                                            font-size: 12px;
                                            color: Theme.text_primary;
                                            horizontal-alignment: left;
                                            wrap: word-wrap;
                                        }
                                        Rectangle { height: 1px; background: Theme.divider; }
                                    }
                                }
                            }
                        }
                    }
                }

                // =========================================================
                // 5. WINDOWS 11 STATUS BAR
                // =========================================================
                Rectangle { height: 1px; background: Theme.divider; }

                Rectangle {
                    height: 26px;
                    background: Theme.sidebar_bg;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 12px;

                        Text {
                            text: root.status_item_count;
                            font-size: 11.5px;
                            color: Theme.text_secondary;
                            vertical-alignment: center;
                        }

                        if root.status_selection_info != "": Rectangle {
                            width: 1px;
                            height: 12px;
                            y: 7px;
                            background: Theme.border;
                        }

                        if root.status_selection_info != "": Text {
                            text: root.status_selection_info;
                            font-size: 11.5px;
                            color: Theme.text_primary;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        FluentIconButton {
                            width: 24px;
                            height: 22px;
                            y: 2px;
                            icon: "\u{E8FD}";
                            is_active: root.view_mode == "details";
                            clicked => { root.command_set_view("details"); }
                        }

                        FluentIconButton {
                            width: 24px;
                            height: 22px;
                            y: 2px;
                            icon: "\u{E8A9}";
                            is_active: root.view_mode != "details";
                            clicked => { root.command_set_view("large_icons"); }
                        }
                    }
                }
            }

            // =========================================================
            // 6. FLOATING WINDOWS 11 COMMAND BAR FLYOUT MENUS (NEW, SORT, VIEW + SHOW >)
            // =========================================================
            if root.active_flyout != "": TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.active_flyout = "";
                    root.show_sub_flyout = false;
                }
            }

            // "+ New" Flyout Menu
            if root.active_flyout == "new": Rectangle {
                x: 10px;
                y: 126px;
                width: 225px;
                height: 146px;
                border-radius: 7px;
                background: Theme.flyout_bg;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 5px;
                    spacing: 2px;

                    FlyoutMenuItem {
                        icon: "\u{E8B7}";
                        icon_color: #f5ba18;
                        label: "Folder";
                        clicked => {
                            root.active_flyout = "";
                            root.command_new_folder();
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        icon: "\u{E8A5}";
                        icon_color: #60cdff;
                        label: "Text Document";
                        clicked => {
                            root.active_flyout = "";
                            root.command_new_file("New Text Document.txt");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E943}";
                        icon_color: #b4a0ff;
                        label: "Markdown Document";
                        clicked => {
                            root.active_flyout = "";
                            root.command_new_file("Notes.md");
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        icon: "\u{E774}";
                        icon_color: #28c76f;
                        label: "Map Network Drive (NAS)...";
                        clicked => {
                            root.active_flyout = "";
                            root.command_map_network_drive();
                        }
                    }
                }
            }

            // "Sort" Flyout Menu
            if root.active_flyout == "sort": Rectangle {
                x: 318px;
                y: 126px;
                width: 195px;
                height: 222px;
                border-radius: 7px;
                background: Theme.flyout_bg;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 5px;
                    spacing: 2px;

                    FlyoutMenuItem {
                        label: "Name";
                        is_checked: root.sort_column == "name";
                        clicked => {
                            root.active_flyout = "";
                            root.sort_by("name");
                        }
                    }

                    FlyoutMenuItem {
                        label: "Date modified";
                        is_checked: root.sort_column == "date";
                        clicked => {
                            root.active_flyout = "";
                            root.sort_by("date");
                        }
                    }

                    FlyoutMenuItem {
                        label: "Type";
                        is_checked: root.sort_column == "type";
                        clicked => {
                            root.active_flyout = "";
                            root.sort_by("type");
                        }
                    }

                    FlyoutMenuItem {
                        label: "Size";
                        is_checked: root.sort_column == "size";
                        clicked => {
                            root.active_flyout = "";
                            root.sort_by("size");
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        label: "Ascending";
                        is_checked: root.sort_asc;
                        clicked => {
                            root.active_flyout = "";
                            root.sort_direction(true);
                        }
                    }

                    FlyoutMenuItem {
                        label: "Descending";
                        is_checked: !root.sort_asc;
                        clicked => {
                            root.active_flyout = "";
                            root.sort_direction(false);
                        }
                    }
                }
            }

            // "View" Flyout Menu (Exact replica of Screenshot 1)
            if root.active_flyout == "view": Rectangle {
                x: 392px;
                y: 126px;
                width: 215px;
                height: 378px;
                border-radius: 7px;
                background: Theme.flyout_bg;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 5px;
                    spacing: 2px;

                    FlyoutMenuItem {
                        icon: "\u{E740}";
                        label: "Extra large icons";
                        is_checked: root.view_mode == "xl_icons";
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("xl_icons");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E8A9}";
                        label: "Large icons";
                        is_checked: root.view_mode == "large_icons";
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("large_icons");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{F0E2}";
                        label: "Medium-sized icons";
                        is_checked: root.view_mode == "icons";
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("icons");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E80A}";
                        label: "Small icons";
                        is_checked: root.view_mode == "small_icons";
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("small_icons");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E8FD}";
                        label: "List";
                        is_checked: root.view_mode == "list";
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("list");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E8FD}";
                        label: "Details";
                        is_checked: root.view_mode == "details";
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("details");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{ECA5}";
                        label: "Tiles";
                        is_checked: root.view_mode == "tiles";
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("tiles");
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E8FD}";
                        label: "Content";
                        is_checked: root.view_mode == "content";
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_set_view("content");
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        icon: "\u{E946}";
                        icon_color: Theme.accent;
                        label: "Details pane";
                        is_checked: root.show_details;
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_toggle_details();
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E890}";
                        icon_color: Theme.accent;
                        label: "Preview pane";
                        is_checked: root.show_preview;
                        hovered => { root.show_sub_flyout = false; }
                        clicked => {
                            root.active_flyout = "";
                            root.command_toggle_preview();
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        label: "Show";
                        has_chevron: true;
                        hovered => { root.show_sub_flyout = true; }
                        clicked => { root.show_sub_flyout = !root.show_sub_flyout; }
                    }
                }
            }

            // Cascading "Show >" Submenu (Exact replica of Screenshot 1: Navigation pane, Compact view, Item check boxes, File name extensions, Hidden items)
            if root.active_flyout == "view" && root.show_sub_flyout: Rectangle {
                x: 605px;
                y: 356px;
                width: 215px;
                height: 174px;
                border-radius: 7px;
                background: Theme.flyout_bg;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 5px;
                    spacing: 2px;

                    FlyoutMenuItem {
                        icon: "\u{E8FD}";
                        icon_color: Theme.accent;
                        label: "Navigation pane";
                        use_checkmark: true;
                        is_checked: root.show_nav_pane;
                        clicked => {
                            root.show_nav_pane = !root.show_nav_pane;
                            root.active_flyout = "";
                            root.show_sub_flyout = false;
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        icon: "\u{E8CB}";
                        icon_color: Theme.accent;
                        label: "Compact view";
                        use_checkmark: true;
                        is_checked: root.compact_view;
                        clicked => {
                            root.active_flyout = "";
                            root.show_sub_flyout = false;
                            root.command_toggle_compact();
                        }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }

                    FlyoutMenuItem {
                        icon: "\u{E73A}";
                        icon_color: Theme.accent;
                        label: "Item check boxes";
                        use_checkmark: true;
                        is_checked: root.item_check_boxes;
                        clicked => {
                            root.item_check_boxes = !root.item_check_boxes;
                            root.active_flyout = "";
                            root.show_sub_flyout = false;
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E8A5}";
                        icon_color: Theme.accent;
                        label: "File name extensions";
                        use_checkmark: true;
                        is_checked: root.show_file_extensions;
                        clicked => {
                            root.active_flyout = "";
                            root.show_sub_flyout = false;
                            root.command_toggle_extensions();
                        }
                    }

                    FlyoutMenuItem {
                        icon: "\u{E7B3}";
                        label: "Hidden items";
                        use_checkmark: true;
                        is_checked: root.show_hidden;
                        clicked => {
                            root.active_flyout = "";
                            root.show_sub_flyout = false;
                            root.command_toggle_hidden();
                        }
                    }
                }
            }
        }
    }
}
